# Targets chezmoi should delete from the destination. Deleting a source file
# only stops chezmoi managing the target; it leaves the deployed copy in place.

# Local observability stack.
# run_before_00-remove-observability-stack stops and disables the units first,
# so systemd is not left holding a unit file that has been deleted underneath
# it. That pass also clears what chezmoi never managed: the downloaded
# binaries and the data directories.
.config/systemd/user/prometheus.service
.config/systemd/user/loki.service
.config/systemd/user/tempo.service
.config/systemd/user/grafana.service
.config/systemd/user/zellijstat.service
.config/systemd/user/zellij-observability.target
.config/prometheus
.config/loki
.config/tempo
.config/grafana
.local/bin/zellijstat

# rtk, a Claude Code Bash output filter.
.claude/RTK.md
.local/bin/rtk

# The retired RSA key and its ssh-agent state.
.ssh/id_rsa
.ssh/id_rsa.pub
.ssh/ssh-agent

# GPG configuration and the armored secret-key export. Commits sign with the
# SSH key; the local keyring stays so old signatures still verify.
.gnupg/gpg.conf
.gnupg/gpg-agent.conf
.gnupg/secret-keys.asc
