# Targets chezmoi should delete from the destination. Deleting a source file
# only stops chezmoi managing the target; it leaves the deployed copy in place.

# rtk, a Claude Code Bash output filter.
.claude/RTK.md
.local/bin/rtk

# The retired 1Password SSH agent's key filter.
.config/1Password/ssh/agent.toml

# The retired RSA key and its ssh-agent state.
.ssh/id_rsa
.ssh/id_rsa.pub
.ssh/ssh-agent

# The retired GPG config and secret-key export. The keyring stays so old
# signatures still verify.
.gnupg/gpg.conf
.gnupg/gpg-agent.conf
.gnupg/secret-keys.asc

# Release binaries mise installs under ~/.local/share/mise. A copy left here
# puts a second version on PATH.
.local/bin/act
.local/bin/alloy
.local/bin/chezmoi
.local/bin/gcx
.local/bin/just
.local/bin/lazygit
.local/bin/lychee
.local/bin/trivy
.local/bin/truenas-mcp
.local/bin/uv
.local/bin/vale
.local/bin/yq
.local/bin/zellij
.local/lib/bats

# gh's install manifest for gh-poi. Beside the mise shim link, it reports a
# stale pinned version.
.local/share/gh/extensions/gh-poi/manifest.yml

# The Claude edit guard under its former name.
.claude/hooks/pre-commit-edit-guard.sh
