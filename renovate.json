{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/London",
  "reviewers": ["alunduil"],
  "labels": ["dependencies"],
  "pre-commit": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Update types with no release timestamp can never satisfy the bake, and internalChecksFilter defaults to strict, so without this they stall on a pending renovate/stability-days check forever",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "ghcup's metadata has no cabal release dates, so these could never satisfy the bake; ghcup's curation replaces it",
      "matchDatasources": ["custom.ghcup"],
      "matchPackageNames": ["Cabal"],
      "minimumReleaseAge": null
    }
  ],
  "customDatasources": {
    "ghcup": {
      "description": "Releases from the metadata ghcup itself reads; packageName is the tool's key under ghcupDownloads",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/haskell/ghcup-metadata/master/ghcup-0.1.0.yaml",
      "format": "yaml",
      "transformTemplates": [
        "( $installable := function($v) { $exists($v.viArch.A_64.Linux_Debian) or $exists($v.viArch.A_64.Linux_UnknownLinux) }; { \"releases\": [$each(ghcupDownloads.{{packageName}}.toolVersions, function($v, $k) { $installable($v) ? { \"version\": $k, \"releaseTimestamp\": $v.viReleaseDay } })] } )"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated *_VERSION pins in the install scripts and bootstrap passes",
      "managerFilePatterns": ["script/install/*", ".chezmoiscripts/*.tmpl"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_VERSION=\"(?<currentValue>.+?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "chezmoi externals, pinned as release-asset or source-archive URLs. currentValue omits the tag prefix so the replace also bumps the copy of the version in an asset filename; the prefix rebuilds extractVersion, keeping sibling tag families such as lychee-lib-v* out",
      "managerFilePatterns": [".chezmoiexternal.toml"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<tagPrefix>[^/\\d]*)(?<currentValue>\\d[^/]*)/[^\"]*",
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/refs/tags/(?<tagPrefix>[^/\\d]*)(?<currentValue>\\d[^/]*?)\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^{{{tagPrefix}}}(?<version>\\d.*)$"
    },
    {
      "customType": "regex",
      "description": "Zellij plugins, pinned as release-asset URLs rather than a version assignment",
      "managerFilePatterns": ["dot_config/zellij/config.kdl"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "chezmoi pin in the bootstrap tutorial; annotating it would leak Renovate syntax into a copy-pasted snippet",
      "managerFilePatterns": ["docs/tutorials/bootstrap.md"],
      "matchStrings": ["CHEZMOI_VERSION=\"(?<currentValue>v[\\d.]+)\""],
      "depNameTemplate": "twpayne/chezmoi",
      "datasourceTemplate": "github-releases"
    }
  ]
}
