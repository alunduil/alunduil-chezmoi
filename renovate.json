{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config",
    "github>alunduil/renovate-config:automerge-minor",
    ":automergeDigest"
  ],
  "packageRules": [
    {
      "description": "A required CI job runs each of these the way the host does, so green CI covers a 0.x patch",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch"],
      "matchDepNames": [
        "github:lycheeverse/lychee",
        "npm:bats-support",
        "uv",
        "zellij"
      ],
      "automerge": true
    },
    {
      "description": "script/checks/pinned-tools exercises these beyond --version, so green CI covers a 0.x patch; each needs a RUN_COMMANDS entry there",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch"],
      "matchDepNames": [
        "act",
        "github:fourmolu/fourmolu",
        "lazygit",
        "ormolu"
      ],
      "automerge": true
    },
    {
      "description": "ansible-core can't install on Python 3.15: mise never builds its dependencies from source, and PyYAML publishes no 3.15 wheels",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "description": "CI never exercises these pins, so green CI shows only that the file parses",
      "matchFileNames": [
        "dot_config/zellij/config.kdl",
        ".github/workflows/daily.yml",
        ".github/workflows/weekly.yml"
      ],
      "automerge": false
    }
  ],
  "customDatasources": {
    "ghcup": {
      "description": "Releases from the metadata ghcup itself reads; packageName is the tool's key under ghcupDownloads",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/haskell/ghcup-metadata/master/ghcup-0.1.0.yaml",
      "format": "yaml",
      "transformTemplates": [
        "( $installable := function($v) { $exists($v.viArch.A_64.Linux_Debian) or $exists($v.viArch.A_64.Linux_UnknownLinux) }; { \"releases\": [$each(ghcupDownloads.{{packageName}}.toolVersions, function($v, $k) { $installable($v) ? { \"version\": $k, \"releaseTimestamp\": $v.viReleaseDay } })] } )"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated *_VERSION pins in the install scripts and bootstrap passes",
      "managerFilePatterns": ["script/install/*", ".chezmoiscripts/*.tmpl"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_VERSION=\"(?<currentValue>.+?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Zellij plugins, pinned as release-asset URLs rather than a version assignment",
      "managerFilePatterns": ["dot_config/zellij/config.kdl"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
