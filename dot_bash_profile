# Points ssh-add and other agent clients at the agent ssh-load fills. ssh and
# git signing load the key on first use, so login never waits on 1Password. A
# forwarded agent in a remote session takes precedence.
if [ -z "$SSH_AUTH_SOCK" ]; then
   export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

# Load the POSIX-standard profile, which in turn sources ~/.bashrc for
# interactive shells. Without this, bash would read ~/.bash_profile on login
# and never touch ~/.profile at all.
if [ -f "$HOME/.profile" ]; then
    . "$HOME/.profile"
fi
