#!/usr/bin/env bash

set -euo pipefail

# usage: the script's documentation and its -h/--help output, in one place.
usage() {
    cat <<'EOF'
Usage: host-status [OPTIONS]

  List what this host still needs after chezmoi apply: interactive
  logins, managed systemd units that are not running, and tools that
  are not installed. Each line ends with the command that fixes it.

  Prints nothing and exits 0 when nothing is outstanding.

Options:
  -h, --help  Show this message and exit.
EOF
}

read -ra apt_packages <<<'{{ join " " .packages.apt }}'

# Installed by bootstrap passes outside apt and mise, so neither package
# list covers them.
commands=(
    beet bobbit cabal cargo cargo-cache claude code devcontainer ghc ghcup
    node pnpm readwise rustc rustup tailscale uptimerobot
)

system_units=(
    apt-daily.timer apt-daily-upgrade.timer docker-prune.timer
    sysstat.service sysstat-collect.timer tailscaled.service
)

user_units=(
    alloy.service cgroup-pids-textfile.timer
    dev-cache-gc.timer git-poi-all.timer git-worktree-poi.timer
    ssh-agent.service systemd-tmpfiles-clean.timer
)

outstanding=0

# report <item> <fix>: print one outstanding item and the command that
# fixes it.
report() {
    printf '%-40s %s\n' "$1" "$2"
    outstanding=1
}

# check_login <name> <fix> <test...>: report <fix> unless <test> passes.
# Each test reads local state, so an offline host still reports correctly.
check_login() {
    local name=$1 fix=$2
    shift 2
    "$@" >/dev/null 2>&1 || report "$name: not logged in" "$fix"
}

check_logins() {
    check_login gh 'gh auth login' gh auth token
    check_login claude claude test -s "$HOME/.claude/.credentials.json"
    check_login gcx 'gcx login' test -s "$HOME/.config/gcx/config.yaml"
    check_login readwise 'readwise login' test -s "$HOME/.readwise-cli.json"
    check_login tailscale 'sudo tailscale up' tailscale status
    check_login keybase 'keybase login' test -s "$HOME/.config/keybase/config.json"
    check_login signal signal-desktop test -s "$HOME/.config/Signal/sql/db.sqlite"
}

# unit_running <--system|--user> <unit>: whether <unit> is enabled and active.
unit_running() {
    systemctl "$1" is-enabled --quiet "$2" 2>/dev/null &&
        systemctl "$1" is-active --quiet "$2" 2>/dev/null
}

check_units() {
    local unit
    for unit in "${system_units[@]}"; do
        unit_running --system "$unit" ||
            report "$unit: not running" "sudo systemctl enable --now $unit"
    done
    if ! systemctl --user show-environment >/dev/null 2>&1; then
        report 'user units: no user systemd session' \
            "chezmoi apply from a login session, or sudo loginctl enable-linger ${USER:-$(id -un)}"
        return
    fi
    for unit in "${user_units[@]}"; do
        unit_running --user "$unit" ||
            report "$unit: not running" "systemctl --user enable --now $unit"
    done
    # The unit exits at once when the app was already started another way,
    # leaving it inactive while 1Password runs.
    pgrep -x 1password >/dev/null 2>&1 || unit_running --user 1password.service ||
        report '1password.service: not running' 'systemctl --user enable --now 1password.service'
}

check_tools() {
    local pkg status tool version cmd
    local -A installed=()
    while read -r pkg status; do
        [[ "$status" == installed ]] && installed[$pkg]=1
    done < <(dpkg-query -W -f='${Package} ${db:Status-Status}\n' "${apt_packages[@]}" 2>/dev/null)
    for pkg in "${apt_packages[@]}"; do
        [[ -n "${installed[$pkg]:-}" ]] || report "$pkg: not installed" 'chezmoi apply'
    done

    while read -r tool version _; do
        report "$tool $version: not installed" 'chezmoi apply'
    done < <(mise ls --missing --global 2>/dev/null)

    for cmd in "${commands[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || report "$cmd: not on PATH" 'chezmoi apply'
    done
}

# Tests source this script to read the lists above without running the
# checks.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0; fi

case "${1:-}" in
'') ;;
-h | --help) usage; exit 0 ;;
*) printf 'host-status: unknown option: %s (try --help)\n' "$1" >&2; exit 2 ;;
esac

check_logins
check_units
check_tools
exit "$outstanding"
