#!/usr/bin/env python3
"""Match foot's color theme to daylight at this host's location.

ChromeOS does not propagate its light/dark setting into the Crostini
container: the appearance portal reports "no preference", ``CrosAdapta`` has
no dark variant, and no ``prefer-dark`` setting exists. foot would not read
it in any case, switching only on SIGUSR1/SIGUSR2 or a key binding. Daylight
is therefore computed here, from the clock and the coordinates the tz
database records for the host's timezone.

Running and future windows need separate mechanisms: a signal switches the
former, ``initial-color-theme`` in the state file covers the latter. A run
whose computed theme already matches the state file does nothing, which keeps
the five-minute timer from redrawing every window all day.
"""

from __future__ import annotations

import argparse
import os
import re
import signal
import sys
from datetime import UTC, datetime
from enum import Enum
from math import acos, asin, cos, degrees, radians, sin, tan
from pathlib import Path
from typing import NamedTuple

# Elevation of the sun's centre at sunrise/sunset: half a solar diameter
# below the horizon plus atmospheric refraction. This is the figure behind
# published sunset times.
SUNSET_ELEVATION = -0.833

# Both tables, in this order. zone1970.tab merges zones that have agreed since
# 1970, so it omits around a hundred that zone.tab still lists separately --
# Europe/Oslo, Stockholm, Copenhagen and Amsterdam among them. Searching only
# the first leaves the theme stuck on arrival in any of those.
ZONEINFO = Path("/usr/share/zoneinfo")
ZONE_TABS = (ZONEINFO / "zone1970.tab", ZONEINFO / "zone.tab")
DEFAULT_STATE = Path.home() / ".config" / "foot" / "theme-state.ini"


class Theme(Enum):
    """A foot color theme, with the two ways foot is told to select it.

    foot 1.25 numbers its color sections rather than naming them: [colors] is
    dark, [colors2] light, and ``initial-color-theme`` takes the number. A
    signal switches a window already running. script/install/foot covers why
    1.26, which renamed the sections, is not in use.
    """

    section: str
    switch_signal: signal.Signals

    DARK = ("1", signal.SIGUSR1)
    LIGHT = ("2", signal.SIGUSR2)

    def __init__(self, section: str, switch_signal: signal.Signals) -> None:
        self.section = section
        self.switch_signal = switch_signal

    def __str__(self) -> str:
        return self.name.lower()

    @classmethod
    def from_section(cls, section: str) -> Theme:
        for theme in cls:
            if theme.section == section:
                return theme
        raise ValueError(f"no theme uses config section {section!r}")


class Coordinates(NamedTuple):
    """A point on the earth, in signed decimal degrees."""

    latitude: float
    longitude: float


_ISO6709 = re.compile(
    r"([+-])(\d{2})(\d{2})(\d{2})?"  # latitude:  ±DDMM[SS]
    r"([+-])(\d{3})(\d{2})(\d{2})?$"  # longitude: ±DDDMM[SS]
)


def parse_iso6709(value: str) -> Coordinates:
    """Decode a zone.tab ``±DDMM±DDDMM`` (or ``±DDMMSS±DDDMMSS``) coordinate.

    The sign is captured separately from the degrees because a longitude
    such as ``-0000731`` (7'31" *west*) has a zero degrees field, and
    ``int("-000")`` would discard the hemisphere.
    """
    match = _ISO6709.match(value)
    if match is None:
        raise ValueError(f"not an ISO 6709 coordinate: {value!r}")
    lat_sign, lat_d, lat_m, lat_s, lon_sign, lon_d, lon_m, lon_s = match.groups()

    def combine(sign: str, deg: str, minute: str, second: str | None) -> float:
        magnitude = int(deg) + int(minute) / 60 + int(second or 0) / 3600
        return -magnitude if sign == "-" else magnitude

    return Coordinates(
        latitude=combine(lat_sign, lat_d, lat_m, lat_s),
        longitude=combine(lon_sign, lon_d, lon_m, lon_s),
    )


def coordinates_for_timezone(tz_name: str, *zone_tabs: str) -> Coordinates:
    """Look a timezone's coordinates up in zone table contents, in order.

    Both tables share the row format ``codes<TAB>coordinates<TAB>zone``,
    with trailing comment fields on some rows.
    """
    for zone_tab in zone_tabs:
        for line in zone_tab.splitlines():
            if line.startswith("#"):
                continue
            fields = line.split("\t")
            if len(fields) >= 3 and fields[2] == tz_name:
                return parse_iso6709(fields[1])
    raise LookupError(f"no coordinates for timezone {tz_name!r}")


# The instant the series below are expanded around, and the length of the
# unit they count. Every other number in them is a fitted coefficient with no
# meaning apart from its position.
J2000_EPOCH = 2451545.0
DAYS_PER_JULIAN_CENTURY = 36525.0


class _SolarElements(NamedTuple):
    """The sun's orbital position at one instant, as the NOAA series compute it."""

    mean_longitude: float  # degrees
    mean_anomaly: float  # radians
    eccentricity: float
    obliquity: float  # radians
    declination: float  # radians


def julian_day(when: datetime) -> float:
    """Days since the start of the Julian period, the astronomical day count."""
    when = when.astimezone(UTC)
    year, month = when.year, when.month
    day = when.day + (when.hour + when.minute / 60 + when.second / 3600) / 24
    # January and February count as months 13 and 14 of the previous year, so
    # the leap day always falls at the end of the arithmetic year.
    if month <= 2:
        year -= 1
        month += 12
    century = year // 100
    gregorian = 2 - century + century // 4
    return (
        int(365.25 * (year + 4716))
        + int(30.6001 * (month + 1))
        + day
        + gregorian
        - 1524.5
    )


def julian_century(when: datetime) -> float:
    """Julian centuries since J2000.0, the time scale the NOAA series take."""
    return (julian_day(when) - J2000_EPOCH) / DAYS_PER_JULIAN_CENTURY


def solar_elements(t: float) -> _SolarElements:
    """Evaluate the NOAA orbital series at Julian century ``t``."""
    mean_longitude = (280.46646 + t * (36000.76983 + t * 0.0003032)) % 360
    mean_anomaly = radians(357.52911 + t * (35999.05029 - 0.0001537 * t))
    eccentricity = 0.016708634 - t * (0.000042037 + 0.0000001267 * t)

    # Equation of the centre: the correction from a circular orbit to the
    # real ellipse.
    centre = (
        sin(mean_anomaly) * (1.914602 - t * (0.004817 + 0.000014 * t))
        + sin(2 * mean_anomaly) * (0.019993 - 0.000101 * t)
        + sin(3 * mean_anomaly) * 0.000289
    )

    # Nutation, driven by the moon's ascending node, perturbs both the
    # apparent longitude and the obliquity.
    omega = radians(125.04 - 1934.136 * t)
    apparent_longitude = radians(
        mean_longitude + centre - 0.00569 - 0.00478 * sin(omega)
    )
    obliquity = radians(
        23
        + (26 + (21.448 - t * (46.815 + t * (0.00059 - t * 0.001813))) / 60) / 60
        + 0.00256 * cos(omega)
    )

    return _SolarElements(
        mean_longitude=mean_longitude,
        mean_anomaly=mean_anomaly,
        eccentricity=eccentricity,
        obliquity=obliquity,
        declination=asin(sin(obliquity) * sin(apparent_longitude)),
    )


def equation_of_time(elements: _SolarElements) -> float:
    """Minutes by which true solar time leads the mean clock.

    Swings roughly ±16 minutes over the year, moving sunset at temperate
    latitudes by more than a quarter hour.
    """
    y = tan(elements.obliquity / 2) ** 2
    longitude = radians(elements.mean_longitude)
    anomaly = elements.mean_anomaly
    eccentricity = elements.eccentricity
    return 4 * degrees(
        y * sin(2 * longitude)
        - 2 * eccentricity * sin(anomaly)
        + 4 * eccentricity * y * sin(anomaly) * cos(2 * longitude)
        - 0.5 * y * y * sin(4 * longitude)
        - 1.25 * eccentricity * eccentricity * sin(2 * anomaly)
    )


def hour_angle(when: datetime, longitude: float, offset_minutes: float) -> float:
    """Radians the earth has turned past the sun being due south."""
    when = when.astimezone(UTC)
    minutes = when.hour * 60 + when.minute + when.second / 60
    # Four minutes of rotation per degree of longitude.
    true_solar_time = (minutes + offset_minutes + 4 * longitude) % 1440
    return radians(true_solar_time / 4 - 180)


def solar_elevation(when: datetime, location: Coordinates) -> float:
    """Elevation of the sun above the horizon, in degrees.

    NOAA's solar position algorithm. Accurate to well under a minute of
    sunrise/sunset time for the next century, which is far tighter than
    anything a terminal theme needs.
    """
    elements = solar_elements(julian_century(when))
    angle = hour_angle(when, location.longitude, equation_of_time(elements))

    latitude = radians(location.latitude)
    declination = elements.declination
    cos_zenith = sin(latitude) * sin(declination) + cos(latitude) * cos(
        declination
    ) * cos(angle)
    # Rounding can push this a hair outside acos's domain at the poles.
    return 90 - degrees(acos(min(1.0, max(-1.0, cos_zenith))))


def theme_for_elevation(elevation: float, horizon: float = SUNSET_ELEVATION) -> Theme:
    """The theme daylight calls for at this sun elevation."""
    return Theme.LIGHT if elevation > horizon else Theme.DARK


def render_state(theme: Theme) -> str:
    """The config fragment foot.ini includes.

    Its own ``[main]`` header is required: an included file has its own
    section scope, so it cannot inherit the including file's.
    """
    return (
        "# Written by foot-theme-auto. Edits are overwritten on the next\n"
        "# daylight transition; change the schedule, not this file.\n"
        f"# Currently: {theme}.\n"
        "[main]\n"
        f"initial-color-theme={theme.section}\n"
    )


# Built from Theme so the accepted values cannot drift from the written ones.
_STATE_PATTERN = re.compile(
    r"^\s*initial-color-theme\s*=\s*({})\s*$".format(
        "|".join(theme.section for theme in Theme)
    ),
    re.M,
)


def read_state(path: Path) -> Theme | None:
    """The theme recorded in the state file, or None if it says nothing."""
    try:
        text = path.read_text()
    except OSError:
        return None
    match = _STATE_PATTERN.search(text)
    return Theme.from_section(match.group(1)) if match else None


def write_state(path: Path, theme: Theme) -> None:
    """Replace the state file atomically.

    foot reads this on startup, and a window racing a half-written file
    would fail to parse its config rather than merely picking the wrong
    colors.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    scratch = path.with_name(f".{path.name}.tmp")
    scratch.write_text(render_state(theme))
    os.replace(scratch, path)


def foot_pids(proc_root: Path = Path("/proc")) -> list[int]:
    """PIDs of running foot processes.

    Matches ``comm`` exactly rather than scanning cmdline, which would also
    catch this script's own ancestry and anything with "foot" in its path.
    """
    pids = []
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if (entry / "comm").read_text().strip() == "foot":
                pids.append(int(entry.name))
        except OSError:
            continue  # exited between listing and reading
    return sorted(pids)


def signal_running(theme: Theme, pids: list[int]) -> int:
    """Switch already-open windows, returning how many took the signal."""
    signalled = 0
    for pid in pids:
        try:
            os.kill(pid, theme.switch_signal)
            signalled += 1
        except OSError:
            continue  # exited since it was listed
    return signalled


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="foot-theme-auto",
        description="Match foot's color theme to daylight at this host's location.",
    )
    parser.add_argument(
        "--horizon",
        type=float,
        default=SUNSET_ELEVATION,
        metavar="DEGREES",
        help=(
            "sun elevation below which the dark theme applies "
            f"(default: {SUNSET_ELEVATION}, true sunset; -6 for civil twilight)"
        ),
    )
    parser.add_argument(
        "--state",
        type=Path,
        default=DEFAULT_STATE,
        metavar="PATH",
        help="config fragment recording the applied theme (default: %(default)s)",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="apply the theme even when the state file already matches",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="report what would change without writing or signalling",
    )
    return parser


def canonical_zone(name: str, zoneinfo: Path = ZONEINFO) -> str:
    """Follow zoneinfo links so an alias reaches the name the tables use.

    The tables list only canonical zones, while the tree also carries
    backward-compatibility links such as US/Eastern.
    """
    path = zoneinfo / name
    if path.is_symlink():
        target = str(path.resolve())
        if "zoneinfo/" in target:
            return target.split("zoneinfo/", 1)[1]
    return name


def timezone_name(
    localtime: Path = Path("/etc/localtime"),
    timezone_file: Path = Path("/etc/timezone"),
) -> str:
    """This host's tz database zone name, e.g. ``Europe/London``.

    ``$TZ`` wins so a caller can check another location without touching
    system files. Otherwise /etc/localtime is authoritative: on Crostini it is
    what ChromeOS rewrites, through maitred's SetTimezone, when the host
    changes timezone. /etc/timezone is a Debian-only echo of it and can drift.

    Whichever source answers, the name is canonicalised through the zoneinfo
    tree, so a legacy alias such as US/Eastern becomes the America/New_York
    the zone tables are keyed by. An abbreviation like ``BST`` is no use here
    for the same reason.
    """
    env = os.environ.get("TZ", "").strip().lstrip(":")
    if env:
        return canonical_zone(env)
    if localtime.is_symlink():
        target = str(localtime.resolve())
        if "zoneinfo/" in target:
            return target.split("zoneinfo/", 1)[1]
    if timezone_file.exists():
        name = timezone_file.read_text().strip()
        if name:
            return canonical_zone(name)
    raise LookupError("cannot determine this host's timezone")


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        tz_name = timezone_name()
        location = coordinates_for_timezone(
            tz_name, *(path.read_text() for path in ZONE_TABS if path.exists())
        )
    except (OSError, LookupError, ValueError) as exc:
        print(f"foot-theme-auto: {exc}", file=sys.stderr)
        return 1

    elevation = solar_elevation(datetime.now(UTC), location)
    theme = theme_for_elevation(elevation, args.horizon)
    recorded = read_state(args.state)

    if args.dry_run:
        print(
            f"{tz_name} ({location.latitude:.4f}, {location.longitude:.4f}) "
            f"sun {elevation:+.2f} deg -> {theme} "
            f"(recorded: {recorded or 'none'})"
        )
        return 0

    if theme is recorded and not args.force:
        return 0

    write_state(args.state, theme)
    signal_running(theme, foot_pids())
    return 0


if __name__ == "__main__":
    sys.exit(main())
