#!/usr/bin/env bash
# Shim for `gh` that enforces --draft on `gh pr create`. Shadows the apt-
# installed /usr/bin/gh because ~/.local/bin sits ahead of /usr/bin on PATH
# (see ~/.profile). Every other invocation execs the real gh unchanged.
#
# Bypass, for a human opening a ready PR:
#   GH_DRAFT_GUARD=off gh pr create ...
# or invoke the real binary directly:
#   /usr/bin/gh pr create ...
#   command -p gh pr create ...
#
# Known limitation: has_draft_flag matches whole tokens rather than parsing
# gh's flags, so `-d` as another flag's value (`--title -d`) passes as
# --draft. That input is rare enough not to justify a gh flag parser.

set -euo pipefail

has_draft_flag() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --draft | -d) return 0 ;;
    esac
  done
  return 1
}

if [ "${1:-}" = "pr" ] && [ "${2:-}" = "create" ] &&
  [ "${GH_DRAFT_GUARD:-}" != "off" ] && ! has_draft_flag "${@:3}"; then
  cat >&2 <<'EOF'
gh wrapper (~/.local/bin/gh): `gh pr create` must include --draft (or -d).
Retry as `gh pr create --draft ...`, or call the GitHub MCP
create_pull_request with draft: true. The user will mark it ready after
reviewing.
EOF
  exit 1
fi

# Find the real gh: first executable `gh` in PATH that isn't this script.
# `readlink -f` is GNU-only; fine on Linux.
self="$(readlink -f "$0")"
IFS=':' read -r -a path_dirs <<<"${PATH:-}"
for dir in "${path_dirs[@]}"; do
  [ -n "$dir" ] || continue
  candidate="$dir/gh"
  [ -x "$candidate" ] || continue
  [ "$(readlink -f "$candidate" 2>/dev/null)" = "$self" ] && continue
  # shellcheck disable=SC2093
  exec "$candidate" "$@"
done

printf 'gh wrapper: real gh not found on PATH\n' >&2
exit 127
