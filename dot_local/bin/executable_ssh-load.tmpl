#!/usr/bin/env bash
# Loads the SSH key from 1Password into the OpenSSH agent when the agent
# holds none. Login shells, ssh (through `Match exec` in ~/.ssh/config), and
# ssh-sign call it, so an expired key raises one 1Password approval dialog and
# the command that needed the key carries on.

set -euo pipefail

export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:?}/ssh-agent.socket"

loaded() { ssh-add -l >/dev/null 2>&1; }

loaded && exit 0

# Parallel callers, such as several git commands at once, queue here for one
# dialog instead of raising one each.
exec 9>"$XDG_RUNTIME_DIR/ssh-load.lock"
flock 9
loaded && exit 0

# Eight hours covers a working day; past it, the next use asks again.
op read '{{ .onepassword.ssh_key }}' | ssh-add -t 8h -
