#!/usr/bin/env bash
# zjstatus rate-limit widget for ~/.config/zellij/layouts/pair.kdl. Requires
# `command_ratelimits_rendermode "dynamic"` so the #[...] directives render
# rather than printing as literal text.
#
# One ribbon per GitHub rate-limit bucket, colored by remaining budget. When
# the budget can't be read, a grey "gh ?" ribbon replaces them so a broken
# widget never looks like an absent one.
#
# /rate_limit itself does not count against the rate limit, so polling is free.

set -euo pipefail

ARROW=$''

ribbon() {
  local bg=$1 text=$2
  printf '#[bg=%s,fg=16]%s#[bg=%s,fg=16] %s #[bg=16,fg=%s]%s' \
    "$bg" "$ARROW" "$bg" "$text" "$bg" "$ARROW"
}

unknown() {
  ribbon 244 'gh ?'
  exit 0
}

json=$(gh api rate_limit 2>/dev/null) || unknown

tsv=$(jq -r '[.resources.core.remaining, .resources.core.limit, .resources.graphql.remaining, .resources.graphql.limit, .resources.search.remaining, .resources.search.limit] | if all(type == "number") then @tsv else error end' <<<"$json" 2>/dev/null) || unknown
[ -n "$tsv" ] || unknown

read -r core_remaining core_limit graphql_remaining graphql_limit search_remaining search_limit <<<"$tsv"

bucket_color() {
  local remaining=$1 limit=$2
  local pct=0
  if [ "$limit" -gt 0 ]; then
    pct=$(( remaining * 100 / limit ))
  fi
  if [ "$pct" -lt 10 ]; then
    printf 196
  elif [ "$pct" -lt 25 ]; then
    printf 214
  else
    printf 154
  fi
}

emit() {
  local label=$1 remaining=$2 limit=$3
  ribbon "$(bucket_color "$remaining" "$limit")" "$label $remaining/$limit"
}

emit core "$core_remaining" "$core_limit"
printf '#[bg=16] '
emit gql "$graphql_remaining" "$graphql_limit"
printf '#[bg=16] '
emit search "$search_remaining" "$search_limit"
