#!/usr/bin/env bash

set -euo pipefail

# usage: the script's documentation and its -h/--help output, in one place.
# Laid out the way Click renders a command's help — Usage synopsis, the full
# description, then an aligned Options block.
usage() {
    cat <<'EOF'
Usage: dev-cache-gc

  Reclaim disk by running each dev tool's native garbage collection. The
  systemd-tmpfiles cleaner deletes ~/.cache entries by age, so it misses:

    - caches outside ~/.cache
    - stale entries in caches still in daily use, such as hook environments
      for deleted worktrees and tool versions an update replaced

  Each tool's own GC is used rather than a blind age-deleter: these trees mix
  regenerable cache with installed toolchains, and only the tool knows which
  is which. Toolchains a tracked config still pins are kept.

  rustup has no GC of its own, so this script uninstalls each toolchain that
  is neither the default nor pinned by a rust-toolchain file in a checkout. A
  pin the scan misses costs one download on the next build.

  A tool whose binary is absent is skipped cleanly; a tool that errors is
  reported without aborting the rest. Run daily by dev-cache-gc.timer; safe to
  run by hand any time.

Options:
  -h, --help     Show this message and exit.
EOF
}

# usage_error MESSAGE: Click's usage-error layout.
usage_error() {
    printf "%s\nTry 'dev-cache-gc --help' for help.\n\nError: %s\n" "$(usage | sed -n 1p)" "$1" >&2
    exit 2
}

if (($#)); then
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    -*) usage_error "No such option: $1" ;;
    *) usage_error "Got unexpected extra argument ($1)" ;;
    esac
fi

# systemd --user does not source ~/.bashrc, and each toolchain installs its
# binaries outside the unit's PATH. Load the same environment ~/.profile and
# .bashrc would so `command -v` resolves whatever mise, nvm, cargo, and ghcup
# installed. Each guard no-ops when the toolchain is absent, which is also what
# lets the tests run against PATH stubs alone.
[[ -d "$HOME/.local/share/mise/shims" ]] && PATH="$HOME/.local/share/mise/shims:$PATH"
export NVM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    nvm use default >/dev/null 2>&1 || true
fi
# shellcheck disable=SC1091
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
# shellcheck disable=SC1091
[[ -f "$HOME/.ghcup/env" ]] && . "$HOME/.ghcup/env"

# NO_COLOR (https://no-color.org): any non-empty value disables colour.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RESET=$'\033[0m'
    RED=$'\033[31m'
    GREEN=$'\033[32m'
else
    BOLD='' DIM='' RESET='' RED='' GREEN=''
fi

declare -a failures=()

# run_gc LABEL [--needs BIN] CMD...: run one tool's native GC, guarding on BIN,
# which defaults to CMD's own binary. --needs names the tool a function wraps.
run_gc() {
    local label=$1 needs
    shift
    if [[ "$1" == --needs ]]; then
        needs=$2
        shift 2
    else
        needs=$1
    fi
    if ! command -v "$needs" >/dev/null 2>&1; then
        printf '%s-- %s: %s absent, skipping%s\n' "$DIM" "$label" "$needs" "$RESET"
        return 0
    fi
    printf '%s==> %s%s\n' "$BOLD" "$label" "$RESET"
    # The `if !` exempts the call from set -e so a failing tool is recorded and
    # skipped, not fatal.
    if ! "$@"; then
        failures+=("$label")
    fi
    printf '\n'
}

# rust_pins: print the channel each rust-toolchain file in a checkout pins.
# Main clones sit under $HOME and worktrees under a hidden directory, so the
# worktree root is walked explicitly while hidden directories are pruned.
rust_pins() {
    local f
    while IFS= read -r -d '' f; do
        if grep -q '^\[toolchain\]' "$f"; then
            sed -nE "s/^[[:space:]]*channel[[:space:]]*=[[:space:]]*[\"']([^\"']+).*/\1/p" "$f"
        else
            head -n 1 "$f" | tr -d '[:space:]'
            printf '\n'
        fi
    done < <(find "$HOME" "${XDG_DATA_HOME:-$HOME/.local/share}/git-worktrees" -xdev -mindepth 1 \
        -type d \( -name '.*' -o -name node_modules -o -name target \) -prune -o \
        -type f \( -name rust-toolchain.toml -o -name rust-toolchain \) -print0 2>/dev/null)
}

# is_pinned TOOLCHAIN PIN...: whether any PIN names TOOLCHAIN. rustup appends
# the host triple to the pinned channel, so a pin matches whole or followed by
# `-`: 1.98.1 names 1.98.1-x86_64-unknown-linux-gnu, and 1.98 doesn't.
is_pinned() {
    local toolchain=$1 pin
    shift
    for pin; do
        [[ "$toolchain" == "$pin" || "$toolchain" == "$pin"-* ]] && return 0
    done
    return 1
}

# prune_rust_toolchains: `rustup toolchain list` marks the default and any
# active toolchain after its name. A marked toolchain is always kept, so a
# checkout pinning a channel name can't cost the default.
prune_rust_toolchains() {
    local toolchain marker failed=0
    local -a pins
    mapfile -t pins < <(rust_pins)
    while read -r toolchain marker; do
        [[ -z "$marker" ]] || continue
        is_pinned "$toolchain" "${pins[@]}" && continue
        rustup toolchain uninstall "$toolchain" || failed=1
    done < <(rustup toolchain list)
    return "$failed"
}

# -c (cache) and -t (tmpdirs) only: -o/-u remove GHC versions and -p/-s strip
# profiling libs / docs from installed toolchains, all of which the version
# store stays out of by design.
run_gc "ghcup cache" ghcup gc -c -t
# npm never expires npx entries. Clearing them all costs no download: npx
# reinstalls from npm's content cache.
run_gc "npx cache" npm cache npx rm --force
run_gc "npm cache" npm cache verify
# cargo-cache, not `cargo cache`: the subcommand form dispatches through
# rustup's cargo shim, which fails when no default toolchain is installed.
run_gc "cargo registry" cargo-cache --autoclean
run_gc "rust toolchains" --needs rustup prune_rust_toolchains
run_gc "pnpm store" pnpm store prune
run_gc "prek cache" prek cache gc
run_gc "pre-commit cache" pre-commit gc
run_gc "mise versions" mise prune --yes

if ((${#failures[@]})); then
    printf '%s%d tool(s) failed:%s\n' "$BOLD" "${#failures[@]}" "$RESET"
    for f in "${failures[@]}"; do
        printf '  %s%s%s\n' "$RED" "$f" "$RESET"
    done
    exit 1
fi

printf '%sdev caches reclaimed%s\n' "$GREEN" "$RESET"
