#!/usr/bin/env bash
# git's gpg.ssh.program: ssh-keygen against the local agent, loading the key
# first when signing. Verifying needs no key, so `git log --show-signature`
# never raises a dialog.

set -euo pipefail

export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:?}/ssh-agent.socket"

if [ "${1:-}" = "-Y" ] && [ "${2:-}" = "sign" ]; then
  "$HOME/.local/bin/ssh-load"
fi

exec ssh-keygen "$@"
