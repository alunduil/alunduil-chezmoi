#!/usr/bin/env bash
# Bootstrap passes converge: they run on every apply and check host state
# before acting. These break that silently -- none is a syntax error, none
# fails an apply, and each leaves a pass that runs and reconciles nothing:
#
#   run_once_    keys off the script's own content, so a package removed by
#                `apt autoremove`, a deleted binary, or a hand-edited /etc
#                file leaves the source untouched and the pass never re-fires.
#   dpkg -s      exits 0 for a package in `config-files` state -- removed with
#                `apt remove` but its conffiles retained -- so it reports a
#                package that is gone from disk as present.
#   exit 0       in a run_onchange_ pass records its hash, so a skip waits for
#                the hashed content to change -- safe only when that content
#                is the missing input.

set -euo pipefail

SOURCE_DIR="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$SOURCE_DIR"

fail=0

report() {
  local remedy="$1" location
  while IFS= read -r location; do
    printf '%s: %s\n' "$location" "$remedy" >&2
    fail=1
  done
}

status_query='dpkg-query -W -f='\''${db:Status-Status}'\'''

report 'run_once_ cannot see host drift; use run_ (converging) or run_onchange_ (content-triggered)' \
  < <(git ls-files '.chezmoiscripts/run_once_*')

# The passes name what they avoid in comments explaining why, and flagging
# those would make the fix undocumentable.
code_matches() {
  git grep -n "$@" | grep -vE '^[^:]+:[0-9]+:[[:space:]]*#' || true
}

report "\`dpkg -s\` is true for config-files state; compare \`$status_query\` to \"installed\"" \
  < <(code_matches 'dpkg -s' -- '.chezmoiscripts/*.tmpl')

unmarked_skips() {
  local file line text hash
  while IFS=: read -r file line text; do
    hash="$(sed -nE 's/.*# rerun-on: ([[:alnum:]-]+-hash)$/\1/p' <<<"$text")"
    [ -n "$hash" ] && grep -q "^# ${hash}: " "$file" && continue
    printf '%s:%s\n' "$file" "$line"
  done < <(code_matches -w 'exit 0' -- '.chezmoiscripts/run_onchange_*')
}

report 'exit 0 records the hash, so this skip waits for hashed content to change; exit non-zero, or mark `# rerun-on: <name>-hash` if that hash covers the missing input' \
  < <(unmarked_skips)

exit "$fail"
