#!/usr/bin/env bash
# Validate the systemd units with `systemd-analyze verify`: every directive must
# be known and every ExecStart binary must resolve. verify resolves %h/%S
# against the calling user, so the binaries the units reference must exist at
# their real paths first — systemd.yml installs them in CI.
#
# Two scopes: user units under dot_config/systemd/user (verified --user) and
# root units under etc/systemd/system (verified system-scope). docker-prune is
# the only system unit; its /usr/bin/docker is preinstalled on the CI runner.
#
# verify only *warns* (and still exits 0) on an unknown directive, so a warning
# fails the check; a missing ExecStart already exits non-zero. System-scope
# verify also warns about the host's own units, which this repo can't fix, so
# only warnings naming our units count.
set -uo pipefail

# Print the lines of verify's stderr, read on stdin, that name one of the given
# units. verify names a unit by absolute path ("<path>:<line>: ...") or by unit
# name ("<name>: ...").
warnings_about() {
  local u
  awk 'NR == FNR { p[++n] = $0; next }
    { for (i = 1; i <= n; i++) if (index($0, p[i]) == 1) { print; next } }' \
    <(for u; do printf '%s:\n%s:\n' "$(realpath -m "$u")" "$(basename "$u")"; done) -
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0; fi

ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$ROOT"
# shellcheck source=script/lib/checks.sh
. script/lib/checks.sh

command -v systemd-analyze >/dev/null 2>&1 || skip "systemd-analyze not on PATH"

user_dir="dot_config/systemd/user"
system_dir="etc/systemd/system"

# Without nullglob a pattern that matches nothing is passed through literally,
# and systemd-analyze fails on the pattern itself rather than reporting an
# empty set. Removing the last unit of a kind is a normal thing to do.
shopt -s nullglob
user_units=("$user_dir"/*.service "$user_dir"/*.target "$user_dir"/*.timer)
system_units=("$system_dir"/*.service "$system_dir"/*.timer)
service_units=("$user_dir"/*.service "$system_dir"/*.service)
shopt -u nullglob

# verify needs every ExecStart binary present. Derive them from the units
# (the first token after ExecStart=, %h expanded) instead of a hand-kept list,
# so adding a unit needs no change here. A binary missing under CI usually
# belongs to a new unit that systemd.yml doesn't install yet.
while IFS= read -r bin; do
  bin="${bin/'%h'/$HOME}"
  [ -x "$bin" ] || skip "$bin not installed"
done < <(printf '%s\0' "${service_units[@]}" |
  xargs -0 -r grep -hoP '^ExecStart(Pre)?=-?\K[^ ]+')

errfile="$(mktemp)"
trap 'rm -f "$errfile"' EXIT
# User units carry %h/%S specifiers, so they verify in --user mode; the root
# units verify system-scope. Both runs write to one stderr file so warnings
# from either scope are checked.
rc=0
if [ "${#user_units[@]}" -gt 0 ]; then
  systemd-analyze --user verify "${user_units[@]}" >/dev/null 2>"$errfile"
  rc=$?
fi
if [ "${#system_units[@]}" -gt 0 ]; then
  systemd-analyze verify "${system_units[@]}" >/dev/null 2>>"$errfile"
  rc=$((rc | $?))
fi
if [ "$rc" -ne 0 ]; then
  printf 'FAIL: systemd unit verification\n' >&2
  cat "$errfile" >&2
  exit 1
fi
if warnings="$(warnings_about "${user_units[@]}" "${system_units[@]}" <"$errfile")" &&
  [ -n "$warnings" ]; then
  printf 'FAIL: systemd unit verification\n%s\n' "$warnings" >&2
  exit 1
fi

printf 'OK: systemd user and system units verify\n'
