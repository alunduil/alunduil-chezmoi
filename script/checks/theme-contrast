#!/usr/bin/env python3
"""Hold the zellij themes, and kitty's copy of the dark one, to WCAG AAA.

Every foreground in a theme block must reach 7:1 against that block's
background. Terminal colors must reach 7:1 against the page background and
stay sixteen distinct values, because vim takes its syntax colors straight
off them. The slots playing the background's role are exempt: black on a
dark theme, white and bright white on a light one.
"""

import pathlib
import re
import sys

AAA = 7.0
THEMES = pathlib.Path("dot_config/zellij/themes")
KITTY_CONF = pathlib.Path("dot_config/kitty/kitty.conf")
KITTY_THEME = "chromeos-dark"
BACKGROUND_ROLE = {"dark": {"black"}, "light": {"white", "bright_white"}}
TERMINAL_SLOTS = [
    "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
    "bright_black", "bright_red", "bright_green", "bright_yellow",
    "bright_blue", "bright_magenta", "bright_cyan", "bright_white",
]  # fmt: skip


def luminance(rgb):
    def channel(value):
        value /= 255
        return value / 12.92 if value <= 0.03928 else ((value + 0.055) / 1.055) ** 2.4

    r, g, b = (channel(v) for v in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    high, low = sorted((luminance(a), luminance(b)), reverse=True)
    return (high + 0.05) / (low + 0.05)


def parse_theme(text):
    """Map each block of a zellij theme file to its {key: (r, g, b)}."""
    blocks = {}
    for name, body in re.findall(r"^\s*(\w+) \{([^{}]*)\}", text, re.M):
        blocks[name] = {
            key: tuple(map(int, rgb))
            for key, *rgb in re.findall(r"(\w+) (\d+) (\d+) (\d+)", body)
        }
    return blocks


def hue(page):
    return "dark" if luminance(page) < 0.18 else "light"


def ui_failures(blocks):
    page = blocks["text_unselected"]["background"]
    failures = []
    for name, colors in blocks.items():
        if name == "terminal_colors":
            continue
        background = colors.get("background", page)
        for key, rgb in colors.items():
            ratio = contrast(rgb, background)
            if key != "background" and ratio < AAA:
                failures.append(f"{name}.{key} is {ratio:.2f}:1")
    return failures


def terminal_failures(blocks):
    page = blocks["text_unselected"]["background"]
    terminal = blocks["terminal_colors"]
    exempt = BACKGROUND_ROLE[hue(page)]
    failures = [f"terminal_colors lacks {slot}" for slot in TERMINAL_SLOTS if slot not in terminal]
    for slot, rgb in terminal.items():
        ratio = contrast(rgb, page)
        if slot not in exempt and ratio < AAA:
            failures.append(f"terminal_colors.{slot} is {ratio:.2f}:1")
    distinct = len(set(terminal.values()))
    if distinct < len(TERMINAL_SLOTS):
        failures.append(f"terminal_colors has {distinct} distinct values, not {len(TERMINAL_SLOTS)}")
    return failures


def parse_kitty(text):
    """Map kitty's foreground, background and color0-15 to (r, g, b)."""
    colors = {}
    for key, value in re.findall(r"^(foreground|background|color\d+)\s+#([0-9a-fA-F]{6})", text, re.M):
        colors[key] = tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))
    return colors


def kitty_failures(kitty, blocks):
    expected = {
        "foreground": blocks["text_unselected"]["base"],
        "background": blocks["text_unselected"]["background"],
    }
    for index, slot in enumerate(TERMINAL_SLOTS):
        expected[f"color{index}"] = blocks["terminal_colors"].get(slot)
    return [f"kitty {key} differs from {KITTY_THEME}" for key, rgb in expected.items() if kitty.get(key) != rgb]


def main():
    failures = []
    themes = {path.stem: parse_theme(path.read_text()) for path in sorted(THEMES.glob("*.kdl"))}
    for name, blocks in themes.items():
        failures += [f"{name}: {f}" for f in ui_failures(blocks) + terminal_failures(blocks)]
    failures += kitty_failures(parse_kitty(KITTY_CONF.read_text()), themes[KITTY_THEME])
    for failure in failures:
        print(failure, file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
