#!/usr/bin/env bash
# Fails unless every mise-pinned tool runs. Installing proves only that the
# asset downloaded and matched mise.lock; running it catches a wrong
# architecture, a libc mismatch, or a binary missing from the archive.
set -uo pipefail

ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
export MISE_GLOBAL_CONFIG_FILE="${MISE_GLOBAL_CONFIG_FILE:-$ROOT/dot_config/mise/config.toml}"

HASKELL_FIXTURE=script/checks/fixtures/pinned-tools.hs

# Tools that don't run as `<last segment of their mise name> --version`. An
# empty entry marks an npm library, which has nothing to run. Commands run from
# the repository root. renovate.json automerges 0.x patches for the tools it
# lists whose command here exercises real use.
declare -A RUN_COMMANDS=(
  [act]='act --list'
  [github:fourmolu/fourmolu]="fourmolu --mode check $HASKELL_FIXTURE"
  [github:seachicken/gh-poi]='gh-poi --help'
  [lazygit]='lazygit -ucf dot_config/lazygit/config.yml'
  [ormolu]="ormolu --mode check $HASKELL_FIXTURE"
  [npm:bats-assert]=''
  [npm:bats-support]=''
)

# Interactive tools never exit on their own and need a terminal. Each runs in
# a pseudo-terminal and passes only when still running after TUI_SECONDS: a
# config that fails to parse or a crash on start exits before then.
declare -A TUI=([lazygit]=1)
TUI_SECONDS=3

run_command() {
  printf '%s\n' "${RUN_COMMANDS[$1]-${1##*/} --version}"
}

check_tool() {
  local tool="$1" cmd bin output status
  local -a argv
  cmd="$(run_command "$tool")"
  if [ -z "$cmd" ]; then
    printf 'OK: %s\n' "$tool"
    return 0
  fi
  read -ra argv <<<"$cmd"
  # A same-named binary elsewhere on PATH can't stand in for one missing from
  # the pinned release.
  if ! bin="$(mise which "${argv[0]}" 2>&1)"; then
    printf 'FAIL: %s: %s\n' "$tool" "$bin" >&2
    return 1
  fi
  argv[0]="$bin"
  if [ -n "${TUI[$tool]:-}" ]; then
    # timeout runs inside the pseudo-terminal: script answers SIGTERM by
    # waiting on its child, and a SIGKILLed script orphans it.
    output="$(script -qec "$(printf '%q ' timeout --kill-after=2 \
      "$TUI_SECONDS" "${argv[@]}")" /dev/null 2>&1 </dev/null)"
    status=$?
    if [ "$status" -ne 124 ]; then
      printf 'FAIL: %s: `%s` exited %s before %ss:\n%s\n' \
        "$tool" "$cmd" "$status" "$TUI_SECONDS" "$output" >&2
      return 1
    fi
    printf 'OK: %s\n' "$tool"
    return 0
  fi
  # stdin is the tool list being looped over; a tool must not consume it.
  if ! output="$("${argv[@]}" 2>&1 </dev/null)"; then
    printf 'FAIL: %s: `%s` exited non-zero:\n%s\n' "$tool" "$cmd" "$output" >&2
    return 1
  fi
  printf 'OK: %s\n' "$tool"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0; fi

cd "$ROOT" || exit 1

if ! tools="$(mise ls --current --json | jq -r 'keys[]')"; then
  printf 'FAIL: could not list mise pins\n' >&2
  exit 1
fi

fail=0
declare -A pinned=()
while read -r tool; do
  pinned[$tool]=1
  check_tool "$tool" || fail=1
done <<<"$tools"

for tool in "${!RUN_COMMANDS[@]}"; do
  if [ -z "${pinned[$tool]:-}" ]; then
    printf 'FAIL: RUN_COMMANDS lists %s, which is not pinned\n' "$tool" >&2
    fail=1
  fi
done

exit "$fail"
