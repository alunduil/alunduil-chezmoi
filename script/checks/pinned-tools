#!/usr/bin/env bash
# Fails unless every mise-pinned tool runs. Installing proves only that the
# asset downloaded and matched mise.lock; running it catches a wrong
# architecture, a libc mismatch, or a binary missing from the archive.
set -uo pipefail

ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
export MISE_GLOBAL_CONFIG_FILE="${MISE_GLOBAL_CONFIG_FILE:-$ROOT/dot_config/mise/config.toml}"

# Tools that don't run as `<last segment of their mise name> --version`. An
# npm library is empty: it has nothing to run.
declare -A RUN_COMMANDS=(
  [github:seachicken/gh-poi]='gh-poi --help'
  [npm:bats-assert]=''
  [npm:bats-support]=''
)

run_command() {
  printf '%s\n' "${RUN_COMMANDS[$1]-${1##*/} --version}"
}

check_tool() {
  local tool="$1" cmd bin output
  local -a argv
  cmd="$(run_command "$tool")"
  read -ra argv <<<"$cmd"
  if [ "${#argv[@]}" -eq 0 ]; then
    printf 'OK: %s\n' "$tool"
    return 0
  fi
  # A same-named binary elsewhere on PATH can't stand in for one missing from
  # the pinned release.
  if ! bin="$(mise which "${argv[0]}" 2>&1)"; then
    printf 'FAIL: %s: %s\n' "$tool" "$bin" >&2
    return 1
  fi
  argv[0]="$bin"
  if ! output="$("${argv[@]}" 2>&1)"; then
    printf 'FAIL: %s: `%s` exited non-zero:\n%s\n' "$tool" "$cmd" "$output" >&2
    return 1
  fi
  printf 'OK: %s\n' "$tool"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0; fi

if ! tools="$(mise ls --current --json | jq -r 'keys[]')"; then
  printf 'FAIL: could not list mise pins\n' >&2
  exit 1
fi

fail=0
declare -A pinned=()
while read -r tool; do
  pinned[$tool]=1
  check_tool "$tool" || fail=1
done <<<"$tools"

for tool in "${!RUN_COMMANDS[@]}"; do
  if [ -z "${pinned[$tool]:-}" ]; then
    printf 'FAIL: RUN_COMMANDS lists %s, which is not pinned\n' "$tool" >&2
    fail=1
  fi
done

exit "$fail"
