#!/usr/bin/env bash
# Bootstraps a fresh Debian host from this checkout as
# docs/tutorials/bootstrap.md does, applies again, and fails on any file the
# second apply changed. A pass whose guard misses its own work reinstalls or
# rewrites something on every apply, and chezmoi exits 0 regardless.
#
# The host is a privileged container booting systemd, so system and user units
# really enable. Secrets stay out: the first apply skips 1Password on a real
# host too, and the encrypted files need an age key CI does not hold. Needs
# docker; a run installs the whole workstation and takes a while.

set -euo pipefail

SOURCE_DIR="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"

image=alunduil-chezmoi-fresh-host
docker build --quiet --tag "$image" - <"$SOURCE_DIR/script/checks/fresh-host.Dockerfile" >/dev/null

host="$(docker run --detach --privileged "$image")"
trap 'docker rm --force "$host" >/dev/null' EXIT

# A login shell, as the tutorial's terminal is. mise's GitHub backend is
# rate-limited without GITHUB_TOKEN.
as_user() {
  docker exec --user ci --workdir /home/ci \
    --env USER=ci --env XDG_RUNTIME_DIR=/run/user/1000 --env GITHUB_TOKEN \
    "$host" bash -lc "set -euo pipefail; $1"
}

for _ in {1..60}; do
  docker exec "$host" test -S /run/user/1000/bus && break
  sleep 1
done
docker exec "$host" test -S /run/user/1000/bus || {
  echo 'FAIL: the user systemd manager did not start' >&2
  docker exec "$host" systemctl --no-pager status user@1000.service >&2 || true
  exit 1
}

echo '==> installing the tutorial prerequisites' >&2
as_user '
  sudo apt-get install -y extrepo git curl gpg
  sudo extrepo enable mise
  sudo apt-get update
  sudo apt-get install -y mise
'

# Tracked files only, including uncommitted edits, in place of the tutorial's
# clone.
git -C "$SOURCE_DIR" ls-files -z |
  tar -C "$SOURCE_DIR" --null --files-from=- --create |
  docker exec --interactive --user ci "$host" \
    sh -c 'mkdir -p ~/.local/share/chezmoi && tar --extract -C ~/.local/share/chezmoi'

echo '==> first apply' >&2
as_user '
  CHEZMOI_NO_1PASSWORD=1 \
    MISE_GLOBAL_CONFIG_FILE=~/.local/share/chezmoi/dot_config/mise/config.toml \
    mise exec chezmoi -- chezmoi init --apply --exclude=encrypted
'

docker exec "$host" touch /var/tmp/second-apply

echo '==> second apply' >&2
as_user '
  export CHEZMOI_NO_1PASSWORD=1
  chezmoi apply --exclude=encrypted
  chezmoi verify --exclude=scripts,encrypted
'

# Status-change time, so a copy that preserves mtimes still shows. The pruned
# paths change on every apply by design.
changed="$(docker exec "$host" find / -xdev \
  \( -path /tmp -o -path /var/tmp -o -path /var/log \
  -o -path /home/ci/.cache \
  -o -path /home/ci/.config/chezmoi/chezmoistate.boltdb \) -prune \
  -o -cnewer /var/tmp/second-apply -printf '  %p\n')"

if [ -n "$changed" ]; then
  echo 'FAIL: the second apply changed these; the pass that wrote each one does not converge:' >&2
  printf '%s\n' "$changed" >&2
  exit 1
fi
