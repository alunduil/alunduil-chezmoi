#!/usr/bin/env bash
set -euo pipefail

# kcov ships source tarballs only -- no release binaries, and Ubuntu dropped the
# package after 22.04 -- so this builds rather than downloads. The toolchain
# (cmake, ninja, binutils-dev, libcurl/libdw/libssl headers) is the caller's to
# provide; every other installer here needs nothing but curl and tar.
#
# GitHub's auto-generated tarballs carry no checksum asset, so the sha256 is
# pinned inline and a version bump trips verify_sha256 until the hash is
# refreshed by hand -- the same supply-chain checkpoint bats-libs takes.
# renovate: datasource=github-releases depName=SimonKagstrom/kcov
KCOV_VERSION="v43"
KCOV_SHA256="4cbba86af11f72de0c7514e09d59c7927ed25df7cebdad087f6d3623213b95bf"

# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname "$0")/lib.sh"

parse_bin_dir "$@"

bin="$BIN_DIR/kcov"
if installed_version_matches "$bin" "$KCOV_VERSION"; then
  printf '==> kcov: %s already installed at %s\n' "$KCOV_VERSION" "$bin" >&2
  exit 0
fi

printf '==> kcov: downloading %s\n' "$KCOV_VERSION" >&2
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

asset="kcov-${KCOV_VERSION}.tar.gz"
curl -fsSL -o "$tmp/$asset" \
  "https://github.com/SimonKagstrom/kcov/archive/refs/tags/${KCOV_VERSION}.tar.gz"
verify_sha256 "$tmp/$asset" "$KCOV_SHA256"

tar -xzf "$tmp/$asset" -C "$tmp"
src="$tmp/kcov-${KCOV_VERSION#v}"

# kcov traces bash by setting PS4 to an expansion of ${BASH_SOURCE}, unbound
# inside `bash -c` under `set -u`. That is the form this repo's bats tests use
# to reach a script's functions, and every one of them fails against an
# unpatched kcov. SimonKagstrom/kcov#236 is open with the line unchanged on
# master, so give the expansion a fallback here. The grep fails the install if
# upstream moves the line, rather than letting the sed quietly stop applying.
helper="$src/src/engines/bash-helper.sh"
# shellcheck disable=SC2016  # matching kcov's literal $-expansion, not writing one
grep -q '\${BASH_SOURCE}' "$helper"
# shellcheck disable=SC2016
sed -i 's/\${BASH_SOURCE}/${BASH_SOURCE:-}/' "$helper"

printf '==> kcov: building %s\n' "$KCOV_VERSION" >&2
cmake -S "$src" -B "$tmp/build" -G Ninja -DCMAKE_BUILD_TYPE=Release
cmake --build "$tmp/build" --parallel

# kcov embeds its HTML report assets, so the two binaries are the whole install
# and `cmake --install`'s share/ tree buys nothing. Copying them honours
# --bin-dir the way the download-and-verify installers beside this one do.
mkdir -p "$BIN_DIR"
install -m 0755 "$tmp/build/src/kcov" "$bin"
install -m 0755 "$tmp/build/src/kcov-system-daemon" "$BIN_DIR/kcov-system-daemon"
