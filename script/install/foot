#!/usr/bin/env bash
set -euo pipefail

# Built from source because upstream ships no binaries and bookworm's foot
# (1.13.1) cannot switch color themes at runtime, which foot-theme-auto needs.
#
# The [wrap-file] overrides below replace foot's own subprojects/*.wrap, which
# track upstream branch heads: a stock build pulls unpinned, unverified
# sources. All three are subprojects rather than apt packages because
# bookworm's wayland-protocols (1.31) and fcft (3.1.5) are older than foot
# accepts, and tllist is not packaged.

# Held at 1.25.0, the last release that builds against bookworm's libxkbcommon
# (1.5.0): from 1.26.0 input.c references XKB_KEYSYM_MAX, added in xkbcommon
# 1.6.0. meson does not catch it, because foot declares only
# `xkbcommon >= 1.0.0`, so it surfaces as a -Werror compile error. Accepting a
# Renovate bump past 1.25 means also building libxkbcommon from source.
# renovate: datasource=forgejo-releases depName=dnkl/foot registryUrl=https://codeberg.org
FOOT_VERSION="1.25.0"
FOOT_SHA256="6572595658c81dde9dd1697a475fceaa2e46fbe8989bed989822643578a2ebe2"

# renovate: datasource=forgejo-releases depName=dnkl/fcft registryUrl=https://codeberg.org
FCFT_VERSION="3.3.3"
FCFT_SHA256="bb298772d625e7d917373d541456f34f1957a9e22b16f17f64158b2c3816563c"

# renovate: datasource=forgejo-releases depName=dnkl/tllist registryUrl=https://codeberg.org
TLLIST_VERSION="1.1.0"
TLLIST_SHA256="a1f0ce0dc4fcb4ce59c37202a1d914c853a8bd2d7c5d57d623b15a8dd9778767"

# renovate: datasource=gitlab-tags depName=wayland/wayland-protocols registryUrl=https://gitlab.freedesktop.org
WAYLAND_PROTOCOLS_VERSION="1.49"
WAYLAND_PROTOCOLS_SHA256="8d94eee148db4d8111ccc0d4331de2f82d4b28c38e30eace9f052886480f7d86"

# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname "$0")/lib.sh"

# Unlike the other installers this lays down a whole prefix -- binaries,
# terminfo, themes, desktop entries -- so it takes --prefix, not --bin-dir.
PREFIX=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix)
      [ $# -ge 2 ] || {
        echo "${0##*/}: --prefix requires an argument" >&2
        exit 2
      }
      PREFIX="$2"
      shift 2
      ;;
    *)
      echo "${0##*/}: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done
[ -n "$PREFIX" ] || {
  echo "${0##*/}: --prefix DIR required" >&2
  exit 2
}

bin="$PREFIX/bin/foot"
if installed_version_matches "$bin" "$FOOT_VERSION"; then
  printf '==> foot: %s already installed at %s\n' "$FOOT_VERSION" "$bin" >&2
  exit 0
fi

printf '==> foot: building %s\n' "$FOOT_VERSION" >&2
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl -fsSL -o "$tmp/foot.tar.gz" \
  "https://codeberg.org/dnkl/foot/releases/download/${FOOT_VERSION}/foot-${FOOT_VERSION}.tar.gz"
verify_sha256 "$tmp/foot.tar.gz" "$FOOT_SHA256"
tar -xzf "$tmp/foot.tar.gz" -C "$tmp"

src="$tmp/foot-${FOOT_VERSION}"

# Pin one subproject: NAME is the wrap meson looks for, DIRECTORY the
# tarball's top-level directory (and, with .tar.gz, its filename). meson
# verifies SHA after download, so a moved or rewritten tarball fails the
# build rather than silently building something else.
write_wrap() {
  local name="$1" directory="$2" url="$3" sha="$4"
  cat >"$src/subprojects/${name}.wrap" <<EOF
[wrap-file]
directory = ${directory}
source_url = ${url}
source_filename = ${directory}.tar.gz
source_hash = ${sha}
EOF
}

write_wrap fcft "fcft-${FCFT_VERSION}" \
  "https://codeberg.org/dnkl/fcft/releases/download/${FCFT_VERSION}/fcft-${FCFT_VERSION}.tar.gz" \
  "$FCFT_SHA256"

write_wrap tllist "tllist-${TLLIST_VERSION}" \
  "https://codeberg.org/dnkl/tllist/releases/download/${TLLIST_VERSION}/tllist-${TLLIST_VERSION}.tar.gz" \
  "$TLLIST_SHA256"

write_wrap wayland-protocols "wayland-protocols-${WAYLAND_PROTOCOLS_VERSION}" \
  "https://gitlab.freedesktop.org/wayland/wayland-protocols/-/archive/${WAYLAND_PROTOCOLS_VERSION}/wayland-protocols-${WAYLAND_PROTOCOLS_VERSION}.tar.gz" \
  "$WAYLAND_PROTOCOLS_SHA256"

# custom-terminfo-install-location makes foot export $TERMINFO into the shell
# it spawns, so `TERM=foot` resolves from a prefix ncurses does not search by
# default. Without it every curses program in a foot window falls back to
# dumb-terminal behaviour.
#
# systemd-units-dir is pinned inside the prefix because meson otherwise
# resolves it from pkg-config to /usr/lib/systemd/user, which a non-root
# install cannot write. utmp-backend=none for the same reason: its helper
# wants to be installed setgid.
meson setup \
  --prefix "$PREFIX" \
  --buildtype release \
  -Dterminfo=enabled \
  -Dcustom-terminfo-install-location=share/terminfo \
  -Dthemes=true \
  -Dtests=false \
  -Dutmp-backend=none \
  -Dsystemd-units-dir="$PREFIX/lib/systemd/user" \
  "$src/build" "$src"

ninja -C "$src/build"
ninja -C "$src/build" install
