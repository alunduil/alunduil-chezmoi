#!/usr/bin/env bash
set -euo pipefail

# No leading "v": Claude Code release tags and `claude --version` are bare
# semver (2.1.219), unlike the github-releases tools.
CLAUDE_VERSION="2.1.219"

# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname "$0")/lib.sh"

parse_bin_dir "$@"

bin="$BIN_DIR/claude"
if installed_version_matches "$bin" "$CLAUDE_VERSION"; then
  printf '==> claude: %s already installed at %s\n' "$CLAUDE_VERSION" "$bin" >&2
  exit 0
fi

# amd64 only (the ha-terminal host that uses this installer is amd64), but pick
# the libc flavour so the same pin verifies on a glibc CI runner and installs
# the musl build on the Alpine HA addon.
if [ -f /lib/libc.musl-x86_64.so.1 ] || ldd /bin/ls 2>/dev/null | grep -q musl; then
  platform="linux-x64-musl"
else
  platform="linux-x64"
fi

printf '==> claude: downloading %s (%s)\n' "$CLAUDE_VERSION" "$platform" >&2
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

base="https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}"
curl -fsSL -o "$tmp/manifest.json" "$base/manifest.json"
curl -fsSL -o "$tmp/claude" "$base/$platform/claude"

# The release manifest carries a SHA256 per platform; extract this platform's
# and verify the download against it. The `":{"` after the key disambiguates
# `linux-x64` from `linux-x64-musl`; [^}]* spans the pretty-printed newlines.
manifest="$(cat "$tmp/manifest.json")"
if [[ $manifest =~ \"$platform\"[[:space:]]*:[[:space:]]*\{[^}]*\"checksum\"[[:space:]]*:[[:space:]]*\"([a-f0-9]{64})\" ]]; then
  expected="${BASH_REMATCH[1]}"
else
  printf '%s: no checksum for %s in manifest\n' "${0##*/}" "$platform" >&2
  exit 1
fi
verify_sha256 "$tmp/claude" "$expected"

mkdir -p "$BIN_DIR"
install -m 0755 "$tmp/claude" "$bin"
