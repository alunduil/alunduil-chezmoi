#!/usr/bin/env bash
set -euo pipefail

# renovate: datasource=github-releases depName=grafana/grafana
GRAFANA_VERSION="v13.2.0"
OS="linux"
ARCH="amd64"

# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname "$0")/lib.sh"

# Accept --bin-dir for a uniform installer interface, but Grafana ships a
# whole tree (conf/, public/), not a lone binary, so it installs under
# XDG_DATA_HOME instead of BIN_DIR.
parse_bin_dir "$@"

data_root="${XDG_DATA_HOME:-$HOME/.local/share}/grafana"
home_path="$data_root/grafana-${GRAFANA_VERSION#v}"
if [ -x "$home_path/bin/grafana" ]; then
  printf '==> grafana: %s already installed at %s\n' "$GRAFANA_VERSION" "$home_path" >&2
  exit 0
fi

printf '==> grafana: downloading %s\n' "$GRAFANA_VERSION" >&2
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# dl.grafana.com/oss/release/ is a mutable alias whose tarball and .sha256
# sidecar are separate objects that can disagree across CDN edges, which is
# indistinguishable from tampering. The release API names the build-stamped
# immutable URL and its hash in one response, so the two cannot skew.
curl -fsSL -o "$tmp/version.json" \
  "https://grafana.com/api/grafana/versions/${GRAFANA_VERSION#v}"
package="$(jq -c --arg os "$OS" --arg arch "$ARCH" \
  'first(.packages[] | select(.os == $os and .arch == $arch)) // empty' \
  "$tmp/version.json")"
if [ -z "$package" ]; then
  printf '%s: release API lists no %s/%s package for %s\n' \
    "${0##*/}" "$OS" "$ARCH" "$GRAFANA_VERSION" >&2
  exit 1
fi

url="$(jq -r '.url' <<<"$package")"
expected="$(jq -r '.sha256' <<<"$package")"

asset="${url##*/}"
curl -fsSL -o "$tmp/$asset" "$url"
verify_sha256 "$tmp/$asset" "$expected"

# Tarball top dir is grafana-<version>/ (no leading v); extract beside it and
# pin a stable `current` symlink the systemd unit points its homepath at.
mkdir -p "$data_root"
tar -xzf "$tmp/$asset" -C "$data_root"
ln -sfn "$home_path" "$data_root/current"
