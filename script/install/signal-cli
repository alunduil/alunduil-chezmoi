#!/usr/bin/env bash
set -euo pipefail

# renovate: datasource=github-releases depName=AsamK/signal-cli
SIGNAL_CLI_VERSION="v0.14.8"
ARCH="Linux-native"

# AsamK's release signing key. Published at keys.openpgp.org with UID
# `AsamK <asamk@gmx.de>`. Pinned here so a swap on the keyserver can't
# silently authorise a forged release.
KEY_URL="https://keys.openpgp.org/vks/v1/by-fingerprint/FA10826A74907F9EC6BBB7FC2BA2CD21B5B09570"
KEY_FPR="FA10826A74907F9EC6BBB7FC2BA2CD21B5B09570"

# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$(dirname "$0")/lib.sh"

parse_bin_dir "$@"

bin="$BIN_DIR/signal-cli"
if installed_version_matches "$bin" "$SIGNAL_CLI_VERSION"; then
  printf '==> signal-cli: %s already installed at %s\n' "$SIGNAL_CLI_VERSION" "$bin" >&2
  exit 0
fi

printf '==> signal-cli: downloading %s\n' "$SIGNAL_CLI_VERSION" >&2
tmp="$(mktemp -d)"
gpghome="$(mktemp -d)"
chmod 700 "$gpghome"
trap 'rm -rf "$tmp" "$gpghome"' EXIT

# Releases ship `.asc` detached signatures, no checksums file, so the
# download is checked against the pinned signing key instead of a sha256.
base="https://github.com/AsamK/signal-cli/releases/download/${SIGNAL_CLI_VERSION}"
asset="signal-cli-${SIGNAL_CLI_VERSION#v}-${ARCH}.tar.gz"
download "$base/$asset" "$tmp/$asset"
download "$base/$asset.asc" "$tmp/$asset.asc"

# The ephemeral keyring keeps the user's ~/.gnupg untouched. Asserting the
# imported fingerprint stops a swapped key from slipping through.
download "$KEY_URL" "$gpghome/key.asc"
GNUPGHOME="$gpghome" gpg --quiet --batch --import "$gpghome/key.asc" 2>/dev/null
actual_fpr="$(GNUPGHOME="$gpghome" gpg --list-keys --with-colons |
  awk -F: '$1 == "fpr" {print $10; exit}')"
if [ "$actual_fpr" != "$KEY_FPR" ]; then
  printf '%s: gpg fingerprint mismatch on %s -- expected %s, got %s\n' \
    "${0##*/}" "$KEY_URL" "$KEY_FPR" "$actual_fpr" >&2
  exit 1
fi
if ! GNUPGHOME="$gpghome" gpg --quiet --batch --verify "$tmp/$asset.asc" "$tmp/$asset" 2>/dev/null; then
  printf '%s: gpg signature verification failed for %s\n' "${0##*/}" "$asset" >&2
  exit 1
fi

tar -xzf "$tmp/$asset" -C "$tmp" signal-cli
mkdir -p "$BIN_DIR"
install -m 0755 "$tmp/signal-cli" "$bin"
