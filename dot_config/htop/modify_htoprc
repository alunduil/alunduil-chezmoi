#!/usr/bin/env bash
# Manage ~/.config/htop/htoprc without fighting htop, which rewrites the
# whole file whenever a setting changes in its UI. chezmoi passes the live
# copy on stdin; this overwrites only the keys below, in place, and leaves
# every other line for htop to own. Keys htop omits are appended, so a
# fresh host gets just these and htop fills in its defaults, including the
# CPU-count-dependent meter layout.
set -euo pipefail

awk -F= '
NR == FNR { keys[++n] = $1; value[$1] = $2; next }
$1 in value { print $1 "=" value[$1]; written[$1] = 1; next }
{ print }
END {
  for (i = 1; i <= n; i++)
    if (!(keys[i] in written))
      print keys[i] "=" value[keys[i]]
}
' /dev/fd/3 - 3<<'OWNED'
color_scheme=6
shadow_other_users=1
highlight_base_name=1
detailed_cpu_time=1
show_cpu_frequency=1
show_cpu_temperature=1
screen_tabs=0
OWNED
