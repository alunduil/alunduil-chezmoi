#!/usr/bin/env bash
# Manage ~/.config/htop/htoprc without fighting htop, which rewrites the
# whole file whenever a setting changes in its UI. chezmoi passes the live
# copy on stdin; this overwrites only the keys below, in place, and leaves
# every other line for htop to own. Keys htop omits are appended, so a
# fresh host gets just these and htop fills in its defaults, including the
# CPU-count-dependent meter layout.
set -euo pipefail

awk '
BEGIN {
  n = split("color_scheme=6 shadow_other_users=1 highlight_base_name=1 " \
    "detailed_cpu_time=1 show_cpu_frequency=1 show_cpu_temperature=1 " \
    "screen_tabs=0", owned, " ")
  for (i = 1; i <= n; i++) {
    split(owned[i], kv, "=")
    order[i] = kv[1]
    value[kv[1]] = kv[2]
  }
}
{
  key = substr($0, 1, index($0, "=") - 1)
  if (key in value) {
    print key "=" value[key]
    seen[key] = 1
  } else {
    print
  }
}
END {
  for (i = 1; i <= n; i++)
    if (!(order[i] in seen))
      print order[i] "=" value[order[i]]
}
'
