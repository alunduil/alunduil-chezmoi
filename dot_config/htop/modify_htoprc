#!/usr/bin/env bash
# htop rewrites htoprc whenever a setting changes in its UI, so this owns
# only the keys that differ from htop's defaults and leaves the rest to
# htop. htop defaults any key a partial file omits, which keeps the meter
# layout it picks by CPU count.
set -euo pipefail

awk -F= '
NR == FNR { keys[++n] = $1; value[$1] = $2; next }
$1 in value { print $1 "=" value[$1]; written[$1] = 1; next }
{ print }
END {
  for (i = 1; i <= n; i++)
    if (!(keys[i] in written))
      print keys[i] "=" value[keys[i]]
}
' /dev/fd/3 - 3<<'OWNED'
color_scheme=6
shadow_other_users=1
highlight_base_name=1
detailed_cpu_time=1
show_cpu_frequency=1
show_cpu_temperature=1
screen_tabs=0
OWNED
