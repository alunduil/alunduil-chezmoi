// Zellij's bundled "default" theme recoloured to match Chrome on ChromeOS:
// the New Tab page background and text, with the side panel's colour for
// selections. ChromeOS tints these from the wallpaper, so a new wallpaper
// needs them resampled. Every foreground meets WCAG AAA (7:1) against its
// background; the bright terminal colours sit at 9:1 so each stays
// distinct from its plain twin.

themes {
    chromeos-dark {
        text_unselected {
            base 255 255 255
            background 73 53 68
            emphasis_0 255 192 148
            emphasis_1 154 211 255
            emphasis_2 158 223 102
            emphasis_3 233 189 255
        }
        text_selected {
            base 255 255 255
            background 44 26 40
            emphasis_0 255 145 70
            emphasis_1 74 177 255
            emphasis_2 150 220 90
            emphasis_3 217 140 255
        }
        ribbon_selected {
            base 70 51 65
            background 150 220 90
            emphasis_0 79 26 34
            emphasis_1 79 26 34
            emphasis_2 70 51 65
            emphasis_3 99 11 20
        }
        ribbon_unselected {
            base 8 6 8
            background 152 152 152
            emphasis_0 14 4 6
            emphasis_1 12 4 15
            emphasis_2 3 7 12
            emphasis_3 19 2 4
        }
        ribbon_hover {
            base 73 53 68
            background 220 220 220
            emphasis_0 79 26 34
            emphasis_1 60 20 70
            emphasis_2 20 49 79
            emphasis_3 99 11 20
        }
        table_title {
            base 158 223 102
            background 73 53 68
            emphasis_0 255 192 148
            emphasis_1 154 211 255
            emphasis_2 158 223 102
            emphasis_3 233 189 255
        }
        table_cell_selected {
            base 255 255 255
            background 44 26 40
            emphasis_0 255 145 70
            emphasis_1 74 177 255
            emphasis_2 150 220 90
            emphasis_3 217 140 255
        }
        table_cell_unselected {
            base 255 255 255
            background 73 53 68
            emphasis_0 255 192 148
            emphasis_1 154 211 255
            emphasis_2 158 223 102
            emphasis_3 233 189 255
        }
        list_selected {
            base 255 255 255
            background 44 26 40
            emphasis_0 255 145 70
            emphasis_1 74 177 255
            emphasis_2 150 220 90
            emphasis_3 217 140 255
        }
        list_unselected {
            base 255 255 255
            background 73 53 68
            emphasis_0 255 192 148
            emphasis_1 154 211 255
            emphasis_2 158 223 102
            emphasis_3 233 189 255
        }
        frame_unselected {
            base 205 205 205
            background 73 53 68
            emphasis_0 255 205 80
            emphasis_1 154 211 255
            emphasis_2 204 199 255
            emphasis_3 233 189 255
        }
        frame_selected {
            base 158 223 102
            background 73 53 68
            emphasis_0 255 205 80
            emphasis_1 154 211 255
            emphasis_2 255 184 224
            emphasis_3 255 192 148
        }
        frame_highlight {
            base 255 205 80
            background 73 53 68
            emphasis_0 102 224 212
            emphasis_1 204 199 255
            emphasis_2 255 205 80
            emphasis_3 255 205 80
        }
        exit_code_success {
            base 158 223 102
            background 73 53 68
            emphasis_0 102 224 212
            emphasis_1 209 204 208
            emphasis_2 255 184 224
            emphasis_3 154 211 255
        }
        exit_code_error {
            base 255 187 194
            background 73 53 68
            emphasis_0 255 205 80
            emphasis_1 255 192 148
            emphasis_2 205 205 205
            emphasis_3 204 199 255
        }
        multiplayer_user_colors {
            player_1 255 184 224
            player_2 154 211 255
            player_3 204 199 255
            player_4 255 205 80
            player_5 102 224 212
            player_6 255 192 148
            player_7 255 187 194
            player_8 205 205 205
            player_9 158 223 102
            player_10 242 197 152
        }
        terminal_colors {
            black 44 26 40
            red 255 187 194
            green 158 223 102
            yellow 255 205 80
            blue 154 211 255
            magenta 233 189 255
            cyan 102 224 212
            white 231 231 231
            bright_black 205 205 205
            bright_red 255 223 225
            bright_green 201 244 163
            bright_yellow 255 229 149
            bright_blue 208 234 255
            bright_magenta 247 223 255
            bright_cyan 177 243 235
            bright_white 255 255 255
        }
    }
}
