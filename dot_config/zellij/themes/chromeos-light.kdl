// Zellij's bundled "default-light" theme recoloured to match Chrome on ChromeOS:
// the New Tab page background and text, with the side panel's colour for
// selections. ChromeOS tints these from the wallpaper, so a new wallpaper
// needs them resampled. script/checks/theme-contrast holds them to WCAG
// AAA; the bright terminal colours reach 9:1 so each stays distinct from
// its plain twin.

themes {
    chromeos-light {
        text_unselected {
            base 31 31 31
            background 255 247 249
            emphasis_0 136 50 0
            emphasis_1 0 76 153
            emphasis_2 15 91 0
            emphasis_3 122 0 182
        }
        text_selected {
            base 31 31 31
            background 248 218 237
            emphasis_0 127 47 0
            emphasis_1 0 71 144
            emphasis_2 14 85 0
            emphasis_3 115 0 171
        }
        ribbon_selected {
            base 255 247 249
            background 62 90 43
            emphasis_0 255 242 217
            emphasis_1 255 242 217
            emphasis_2 255 247 249
            emphasis_3 255 240 240
        }
        ribbon_unselected {
            base 255 247 249
            background 85 77 109
            emphasis_0 255 240 214
            emphasis_1 242 242 244
            emphasis_2 234 243 250
            emphasis_3 255 238 238
        }
        ribbon_hover {
            base 255 247 249
            background 68 61 92
            emphasis_0 255 208 121
            emphasis_1 215 214 220
            emphasis_2 198 221 242
            emphasis_3 255 216 216
        }
        table_title {
            base 15 91 0
            background 255 247 249
            emphasis_0 136 50 0
            emphasis_1 0 76 153
            emphasis_2 15 91 0
            emphasis_3 122 0 182
        }
        table_cell_selected {
            base 31 31 31
            background 248 218 237
            emphasis_0 127 47 0
            emphasis_1 0 71 144
            emphasis_2 14 85 0
            emphasis_3 115 0 171
        }
        table_cell_unselected {
            base 31 31 31
            background 255 247 249
            emphasis_0 136 50 0
            emphasis_1 0 76 153
            emphasis_2 15 91 0
            emphasis_3 122 0 182
        }
        list_selected {
            base 31 31 31
            background 248 218 237
            emphasis_0 127 47 0
            emphasis_1 0 71 144
            emphasis_2 14 85 0
            emphasis_3 115 0 171
        }
        list_unselected {
            base 31 31 31
            background 255 247 249
            emphasis_0 136 50 0
            emphasis_1 0 76 153
            emphasis_2 15 91 0
            emphasis_3 122 0 182
        }
        frame_unselected {
            base 87 82 104
            background 255 247 249
            emphasis_0 99 74 0
            emphasis_1 0 76 153
            emphasis_2 93 6 217
            emphasis_3 122 0 182
        }
        frame_selected {
            base 15 91 0
            background 255 247 249
            emphasis_0 99 74 0
            emphasis_1 0 76 153
            emphasis_2 148 4 112
            emphasis_3 136 50 0
        }
        frame_highlight {
            base 99 74 0
            background 255 247 249
            emphasis_0 0 87 85
            emphasis_1 93 6 217
            emphasis_2 99 74 0
            emphasis_3 99 74 0
        }
        exit_code_success {
            base 15 91 0
            background 255 247 249
            emphasis_0 0 87 85
            emphasis_1 87 84 85
            emphasis_2 148 4 112
            emphasis_3 0 76 153
        }
        exit_code_error {
            base 158 8 33
            background 255 247 249
            emphasis_0 99 74 0
            emphasis_1 136 50 0
            emphasis_2 88 81 111
            emphasis_3 93 6 217
        }
        multiplayer_user_colors {
            player_1 135 57 110
            player_2 44 88 133
            player_3 95 73 140
            player_4 109 81 19
            player_5 32 95 90
            player_6 131 69 33
            player_7 141 59 66
            player_8 88 82 104
            player_9 62 94 45
            player_10 108 80 52
        }
        terminal_colors {
            black 31 31 31
            red 158 8 33
            green 15 91 0
            yellow 99 74 0
            blue 0 76 153
            magenta 148 4 112
            cyan 0 87 85
            white 184 179 204
            bright_black 88 81 111
            bright_red 109 6 23
            bright_green 10 61 0
            bright_yellow 67 51 0
            bright_blue 0 52 105
            bright_magenta 103 3 78
            bright_cyan 0 59 58
            bright_white 255 247 249
        }
    }
}
