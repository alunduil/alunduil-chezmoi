// Zellij config for the pair-session workflow, where a layout plus
// rich info bars earn their keep.
//
// Plugins are pinned by release tag -- Zellij fetches and caches them in
// ~/.cache/zellij/ on first use. Aliases (below) keep references short.
// Per-tab UI lives in the layouts (layouts/default.kdl, layouts/pair.kdl);
// a default_tab_template here would not propagate into layout-spawned tabs
// anyway. The pair layout adds a zjstatus line for PR-aware status; default
// stays minimal.

// Without this, `zellij attach -f` can rerun a subprocess a pane spawned
// instead of the pane's own command. The script has the specifics.
post_command_discovery_hook "zellij-resurrect-command"

// Without this, zellij shows a startup-tips screen whose dismissal saves
// a preference. Saving a preference from inside zellij serializes its
// whole merged config over this file.
show_startup_tips false

// The pair layout puts a pane directly above a zjstatus line, and claude
// and lazygit each anchor a status line to the pane bottom. They collide
// without a bottom border between them.
pane_frame_style "full"

// Defined in themes/. Crostini does not pass the ChromeOS light/dark
// setting to Linux, so nothing reports it and the session starts dark;
// Alt t or the right-click menu switches.
theme_dark "chromeos-dark"
theme_light "chromeos-light"

context_menu {
    common {
        item "Switch light/dark" { ToggleTheme; }
    }
}

// The Zellij terminal (`zellij terminal`), launched from the ChromeOS
// launcher by dev.zellij.Zellij.desktop.
terminal {
    // The only installed font covering U+E0B0, which zellij-rate-limit-status
    // draws. Without it the separator falls back to a Unifont bitmap blob.
    font "JetBrains Mono"
    font_size 11
    padding 4
    hide_pointer_while_typing true
    // WCAG AAA for apps that pick their own colors; the themes already meet it.
    minimum_contrast 7.0
}

plugins {
    zellaude location="https://github.com/ishefi/zellaude/releases/download/v0.5.1/zellaude.wasm"
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm"
}

keybinds {
    shared_except "locked" {
        // Searchable repo/session picker → pair layout in the chosen repo.
        // Alt+/ matches the universal "search/launcher" mnemonic and leaves
        // Alt+p free for zellij's TogglePaneInGroup default.
        bind "Alt /" {
            Run "git-repo-picker" {
                floating true
                close_on_exit true
            }
        }
        // Non-interactive sibling: fan out a pair tab for every worktree at
        // once (idempotent — open tabs are skipped). Alt . neighbours Alt /;
        // it shadows readline's yank-last-arg in unlocked panes, which `!$`
        // covers.
        bind "Alt ." {
            Run "git-repo-picker" "--all-worktrees" {
                floating true
                close_on_exit true
            }
        }
        // Pure tab navigation. Default `MoveFocusOrTab` switches panes when
        // one exists in the direction, which surprises during tab-hopping.
        bind "Alt Left"  { GoToPreviousTab; }
        bind "Alt Right" { GoToNextTab; }
        // t for theme. Shadows readline's transpose-words in unlocked panes.
        bind "Alt t" { ToggleTheme; }
    }
}
