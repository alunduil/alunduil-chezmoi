[Unit]
Description=1Password (SSH agent and op CLI integration)

[Service]
# Crostini runs no XDG autostart and has no system tray, so this unit is what
# keeps the app, and the agent socket it owns, alive with no window open. The
# launcher entry hands off to this instance rather than starting another.
ExecStart=/opt/1Password/1password --silent
# Quitting from the app exits 0 and stays quit; only a crash restarts it.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
