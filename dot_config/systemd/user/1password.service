[Unit]
Description=1Password (SSH agent and op CLI integration)

[Service]
# Crostini has no XDG autostart or system tray, so this unit keeps the app and
# its agent socket alive with no window open. The launcher hands off to it.
ExecStart=/opt/1Password/1password --silent
# Quitting exits 0 and stays quit.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
