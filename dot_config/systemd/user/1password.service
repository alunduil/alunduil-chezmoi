[Unit]
Description=1Password (op CLI integration)
# Without a display the app exits at startup and Restart= loops it into the
# start limit, failing the next `enable --now`.
ConditionEnvironment=DISPLAY

[Service]
# Crostini has no XDG autostart or system tray, so this unit keeps the app
# alive with no window open. The launcher hands off to it.
ExecStart=/opt/1Password/1password --silent
# Quitting exits 0 and stays quit.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
