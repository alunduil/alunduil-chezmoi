[Unit]
Description=Reclaim dev tool caches via each tool's native GC (dev-cache-gc)

[Service]
Type=oneshot
# The user manager's PATH lacks ~/.local/bin, where dev-cache-gc lives; set it
# so ExecStart resolves. The script itself adds mise's shims and sources
# nvm/ghcup to put each toolchain's GC on PATH. No tty here, so the script auto-disables colour and
# the journal stays clean.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/dev-cache-gc
