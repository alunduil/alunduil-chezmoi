#!/usr/bin/env bash
# Installs pinned GHC, cabal-install, and stack through the mise-pinned
# ghcup. Debian's ghc and cabal-install packages lag upstream.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

use_pinned_mise
use_source_mise_config

# GHC and cabal tag releases before ghcup can install them, so Renovate reads
# ghcup's own metadata (custom.ghcup in renovate.json).
# renovate: datasource=custom.ghcup depName=ghc packageName=GHC
GHC_VERSION="9.14.1"
# Renovate's default semver-coerced versioning truncates cabal's fourth
# component, reading the 3.14.1.0 and 3.14.1.1 releases as one version; loose
# compares component-wise.
# renovate: datasource=custom.ghcup depName=cabal packageName=Cabal versioning=loose
CABAL_VERSION="3.18.2.0"
# renovate: datasource=custom.ghcup depName=stack packageName=Stack
STACK_VERSION="3.11.1"

# Only interactive shells put ~/.ghcup/bin on PATH.
GHCUP_BIN="$HOME/.ghcup/bin"
PATH="$(mise where ghcup):$GHCUP_BIN:$PATH"
# Every ghcup subcommand otherwise fetches release metadata to check for newer
# versions, which the guards below must not do.
export GHCUP_SKIP_UPDATE_CHECK=1

# In non-login shells, ~/.bashrc puts ~/.ghcup/bin ahead of the mise shims,
# so a ghcup there shadows the pinned one.
if [ -e "$GHCUP_BIN/ghcup" ]; then
  log "ghcup: removing the unpinned copy in $GHCUP_BIN"
  rm -f "$GHCUP_BIN/ghcup"
fi

# ghcup_pin TOOL VERSION: converge one ghcup-managed tool on its pin.
#
# Both guards read disk alone: ghcup lays down a version-suffixed symlink per
# install, and every tool it manages answers --numeric-version, reporting what
# the unversioned symlink resolves to. `ghcup list` would answer the same two
# questions over the network.
ghcup_pin() {
  local tool="$1" version="$2"

  if [ ! -e "$GHCUP_BIN/$tool-$version" ]; then
    log "$tool: installing $version"
    ghcup install "$tool" "$version"
  fi

  if [ "$("$tool" --numeric-version 2>/dev/null || true)" != "$version" ]; then
    log "$tool: setting $version as default"
    ghcup set "$tool" "$version" >/dev/null
  fi

  log "$tool: $("$tool" --numeric-version)"
}

ghcup_pin ghc "$GHC_VERSION"
ghcup_pin cabal "$CABAL_VERSION"
ghcup_pin stack "$STACK_VERSION"

log "haskell ecosystem complete"
