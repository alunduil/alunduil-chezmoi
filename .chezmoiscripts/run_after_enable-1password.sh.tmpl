#!/usr/bin/env bash

set -euo pipefail

# Headless applies (SSH without lingering, container builds) have no user
# systemd manager; a later interactive apply enables the unit.
if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "==> 1password: no user systemd session; leaving service disabled" >&2
  exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now 1password.service
