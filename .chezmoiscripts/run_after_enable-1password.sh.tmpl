#!/usr/bin/env bash
# The unit hash below re-runs this script whenever the unit changes, so edits
# re-apply via daemon-reload + enable.
# 1password service: {{ include "dot_config/systemd/user/1password.service" | sha256sum }}

set -euo pipefail

# Skip where there is no user systemd manager to talk to (headless apply over
# SSH without lingering, container builds). The unit is still deployed; a
# later interactive apply, or a manual enable, brings the app up.
if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "==> 1password: no user systemd session; leaving service disabled" >&2
  exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now 1password.service
