#!/usr/bin/env bash
# Unit hashes below re-run this script whenever a unit changes, so edits
# (schedule changes, new ExecStart flags) re-apply via daemon-reload + enable.
# service: {{ include "dot_config/systemd/user/foot-theme-auto.service" | sha256sum }}
# timer:   {{ include "dot_config/systemd/user/foot-theme-auto.timer" | sha256sum }}

set -euo pipefail

# Skip where there is no user systemd manager to talk to (headless apply over
# SSH without lingering, container builds). The units are still deployed; a
# later interactive apply, or a manual enable, brings the timer up.
if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "==> foot-theme-auto: no user systemd session; leaving timer disabled" >&2
  exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now foot-theme-auto.timer

# The timer's first run is up to five minutes out, so apply the current theme
# now: otherwise an apply in daylight leaves the next window dark.
systemctl --user start foot-theme-auto.service
