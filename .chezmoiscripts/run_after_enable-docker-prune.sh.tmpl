#!/usr/bin/env bash
# Installs the docker-prune system units into /etc and enables the weekly timer.
# Docker is a rootful system daemon here, so the prune runs as root on a system
# timer rather than the per-user pattern of dev-cache-gc -- chezmoi targets
# $HOME, not /etc, so the units live in etc/ and are copied in with sudo (same
# shape as the unattended-upgrades config). See #312.
#
# Runs on every apply and compares each unit against its deployed copy, so an
# edit here and a hand-edit under /etc both reconcile, and daemon-reload fires
# only when something actually changed.

set -euo pipefail

log() { printf '==> %s\n' "$*" >&2; }

# Docker is the whole point; a host without it has nothing to prune.
if ! command -v docker >/dev/null 2>&1; then
  log "docker-prune: docker absent; skipping"
  exit 0
fi

UNIT_SRC="{{ .chezmoi.sourceDir }}/etc/systemd/system"

changed=0
for unit in docker-prune.service docker-prune.timer; do
  if ! cmp -s "$UNIT_SRC/$unit" "/etc/systemd/system/$unit"; then
    log "docker-prune: installing $unit"
    sudo install -m 0644 "$UNIT_SRC/$unit" "/etc/systemd/system/$unit"
    changed=1
  fi
done

if [ "$changed" -eq 1 ]; then
  sudo systemctl daemon-reload
fi

if ! systemctl is-enabled --quiet docker-prune.timer 2>/dev/null ||
  ! systemctl is-active --quiet docker-prune.timer 2>/dev/null; then
  log "docker-prune: enabling timer"
  sudo systemctl enable --now docker-prune.timer
fi
