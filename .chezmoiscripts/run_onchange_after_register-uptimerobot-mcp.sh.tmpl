#!/usr/bin/env bash
# Registers Uptime Robot's remote MCP with Claude Code. UR uses bearer-token
# auth (not OAuth like the Cloudflare MCPs in script 07-before), so the token
# is passed via --header and ends up baked into ~/.claude.json.
#
# Why run_onchange_after instead of a converging run_before pass:
#   - _after_: the token is read from 1Password into
#     ~/.config/uptimerobot/token, which only happens after files are
#     applied.
#   - run_onchange (keyed on the hash below): when the token rotates in
#     1Password, this script reruns and the stale token in ~/.claude.json
#     gets replaced. The token's template source never changes on rotation,
#     so the hash is of the secret value itself.
# token-hash: {{ if not (env "CHEZMOI_NO_1PASSWORD") }}{{ onepasswordRead "op://chezmoi/3cogunhk2hdoelnjlkphiantt4/credential" | sha256sum }}{{ end }}

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

token_file="$HOME/.config/uptimerobot/token"
if [ ! -r "$token_file" ]; then
  log "uptimerobot: token not deployed at $token_file, skipping"
  exit 0
fi

token="$(<"$token_file")"

# Idempotent re-register: remove any existing entry (no-op if absent) and add
# afresh so a rotated token replaces the stale one in ~/.claude.json.
claude mcp remove uptimerobot --scope user >/dev/null 2>&1 || true
log "uptimerobot: registering"
claude mcp add uptimerobot --transport http --scope user \
  https://mcp.uptimerobot.com/mcp \
  --header "Authorization: Bearer ${token}"
