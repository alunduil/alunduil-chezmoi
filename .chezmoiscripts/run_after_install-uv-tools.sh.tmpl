#!/usr/bin/env bash
# Python CLI tools, installed through uv. uv itself is a chezmoi external, so
# it only exists once apply has written its targets -- hence an after pass.

set -euo pipefail

uv="$HOME/.local/bin/uv"

# pre-commit ships only as a Python package, so uv owns its install. --force
# overwrites a pre-existing pip-installed pre-commit on the PATH; the guard
# keys off `uv tool list` rather than `pre-commit --version`, which can't tell
# a uv-managed install from the legacy pip one at the same version.
# renovate: datasource=pypi depName=pre-commit
PRE_COMMIT_VERSION="4.6.2"
if "$uv" tool list 2>/dev/null | grep -qx "pre-commit v$PRE_COMMIT_VERSION"; then
  printf '==> pre-commit: %s already installed via uv\n' "$PRE_COMMIT_VERSION" >&2
else
  printf '==> pre-commit: installing %s via uv\n' "$PRE_COMMIT_VERSION" >&2
  "$uv" tool install --force "pre-commit==$PRE_COMMIT_VERSION"
fi

# Music-library tagger. pyacoustid and musicbrainzngs have no entry point of
# their own, so they ride in beets' tool environment via --with rather than
# being installed as tools; beets 2.x dropped musicbrainzngs as a dependency
# and ships its own MusicBrainz client, so the pin here is deliberate and not
# a restatement of beets' metadata. Its fingerprinter needs fpcalc
# (libchromaprint-tools, script 01). The guard compares the whole requirement
# set, not just beets' version, so bumping either --with pin reinstalls.
# renovate: datasource=pypi depName=beets
BEETS_VERSION="2.14.1"
# renovate: datasource=pypi depName=pyacoustid
PYACOUSTID_VERSION="1.3.1"
# renovate: datasource=pypi depName=musicbrainzngs
MUSICBRAINZNGS_VERSION="0.7.1"
beets_installed="beets v$BEETS_VERSION [required: ==$BEETS_VERSION] [with: pyacoustid==$PYACOUSTID_VERSION, musicbrainzngs==$MUSICBRAINZNGS_VERSION]"
if "$uv" tool list --show-with --show-version-specifiers 2>/dev/null |
  grep -qxF "$beets_installed"; then
  printf '==> beets: %s already installed via uv\n' "$BEETS_VERSION" >&2
else
  printf '==> beets: installing %s via uv\n' "$BEETS_VERSION" >&2
  "$uv" tool install --force \
    --with "pyacoustid==$PYACOUSTID_VERSION" \
    --with "musicbrainzngs==$MUSICBRAINZNGS_VERSION" \
    "beets==$BEETS_VERSION"
fi
