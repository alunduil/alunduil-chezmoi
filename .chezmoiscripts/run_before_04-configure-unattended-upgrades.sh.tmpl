#!/usr/bin/env bash
# Installs unattended-upgrades (plus powermgmt-base for the OnlyOnACPower gate)
# and places its config so updates apply on their own via the
# apt-daily-upgrade timer. The config files live in etc/apt/ as whole files
# (chezmoi can't target /etc, which is outside $HOME) and are copied in with
# sudo. Results land in /var/log/unattended-upgrades/ and the journal -- no
# email or desktop notification (the box is attended), and automatic reboot
# stays off. See #228.
#
# Also installs needrestart, which complements u-u: auto-reboot is off, so when
# an upgrade replaces a shared library the daemons mapping the old copy keep
# running it until they happen to restart. needrestart's apt DPkg::Post-Invoke
# hook restarts them in place after each upgrade, so the security fix takes hold
# without a reboot. See #238.
#
# Runs on every apply and compares each file against its deployed copy, so
# both an edit here and a hand-edit under /etc reconcile. Content hashes are
# not embedded: the comparison reads the real files, which a hash of the
# source cannot see.

set -euo pipefail

log() { printf '==> %s\n' "$*" >&2; }

# install_if_changed SRC DEST [INSTALL_ARGS...]: sudo-installs SRC over DEST
# only when they differ, keeping a converged host free of sudo prompts.
install_if_changed() {
  local src="$1" dest="$2"
  shift 2
  if cmp -s "$src" "$dest"; then
    return 0
  fi
  log "installing $dest"
  sudo install "$@" "$src" "$dest"
}

APT_CONF_SRC="{{ .chezmoi.sourceDir }}/etc/apt"
NEEDRESTART_CONF_SRC="{{ .chezmoi.sourceDir }}/etc/needrestart"

# -------------------------------------------------------------------- install
# powermgmt-base provides on_ac_power, which the OnlyOnACPower gate in
# 50unattended-upgrades needs to read the AC line; without it u-u fails open.
PACKAGES=(unattended-upgrades powermgmt-base needrestart)
# Status field, not `dpkg -s`: see the note in pass 01 -- a package left in
# `config-files` state by `apt remove` still exits 0 there.
missing=()
for pkg in "${PACKAGES[@]}"; do
  status="$(dpkg-query -W -f='${db:Status-Status}' "$pkg" 2>/dev/null || true)"
  [ "$status" = "installed" ] || missing+=("$pkg")
done
if ((${#missing[@]} > 0)); then
  log "installing ${missing[*]}"
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
else
  log "packages already present"
fi

# --------------------------------------------------------------------- config
install_if_changed "$APT_CONF_SRC/20auto-upgrades" /etc/apt/apt.conf.d/20auto-upgrades -m 0644
install_if_changed "$APT_CONF_SRC/50unattended-upgrades" /etc/apt/apt.conf.d/50unattended-upgrades -m 0644

# needrestart drop-in: a conf.d snippet so the package's own needrestart.conf
# stays untouched. -D creates /etc/needrestart/conf.d/ if the package layout
# ever drops it.
install_if_changed "$NEEDRESTART_CONF_SRC/conf.d/zz-alunduil.conf" /etc/needrestart/conf.d/zz-alunduil.conf -D -m 0644

# --------------------------------------------------------------------- timers
for timer in apt-daily.timer apt-daily-upgrade.timer; do
  if ! systemctl is-enabled --quiet "$timer" 2>/dev/null ||
    ! systemctl is-active --quiet "$timer" 2>/dev/null; then
    log "enabling $timer"
    sudo systemctl enable --now "$timer"
  fi
done

log "unattended-upgrades configured"
