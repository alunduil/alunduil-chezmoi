#!/usr/bin/env bash
# Installs nvm, a pinned Node version via nvm, and npm global packages.
# Canonical installers only: nvm for Node, npm for packages. Debian apt Node
# is avoided by design (it lags upstream).

set -euo pipefail

log() { printf '==> %s\n' "$*" >&2; }

# ----------------------------------------------------------------- nvm + Node
# Mirror nvm's own install-location logic: $XDG_CONFIG_HOME/nvm if XDG is set,
# else $HOME/.nvm. Set PROFILE=/dev/null so the installer does NOT append to
# any rc file -- the managed .bashrc sources nvm itself.
# renovate: datasource=github-releases depName=nvm-sh/nvm
NVM_VERSION="v0.40.7"
export NVM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  log "nvm: installing $NVM_VERSION to $NVM_DIR"
  curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | PROFILE=/dev/null bash
else
  log "nvm: already installed at $NVM_DIR"
fi

# shellcheck disable=SC1091
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# Pinned (Renovate-tracked via the node-version datasource). Match by
# explicit version rather than `command -v node`, which could find a system
# /usr/bin/node and skip installation, leaving nvm with zero versions.
# renovate: datasource=node-version depName=node versioning=node
NODE_VERSION="24.19.0"
if ! nvm ls "$NODE_VERSION" >/dev/null 2>&1; then
  log "node: installing $NODE_VERSION via nvm"
  nvm install "$NODE_VERSION"
fi
nvm alias default "$NODE_VERSION"
nvm use default >/dev/null 2>&1
log "node: $(node --version) via nvm"

# Pin npm's global prefix to the nvm-managed node directory so that
# `npm install -g` never falls through to /usr/lib/node_modules (which
# requires root). This is more reliable than `nvm use default` alone
# which can fail silently in non-interactive chezmoi runs.
NPM_CONFIG_PREFIX="$NVM_DIR/versions/node/$(node --version)"
export NPM_CONFIG_PREFIX

# ------------------------------------------------------- npm global installs
# nvm owns the runtime, so every package below lands as the only copy on PATH.

# installed_npm_version PACKAGE: prints the globally installed version of
# PACKAGE, or nothing when it is absent. `npm ls -g` is a local query, no
# network round-trip. It exits 1 when the package is missing (e.g. a fresh
# prefix after a node bump), so `|| true` keeps set -e from killing the run
# before the caller can act on the empty answer.
installed_npm_version() {
  npm ls -g --depth=0 --parseable=false "$1" 2>/dev/null |
    sed -n "s,.*$1@\([0-9][0-9.]*\).*,\1,p" | head -1 || true
}

# pin_npm_global PACKAGE VERSION: converge PACKAGE on exactly VERSION,
# replacing any other version already installed so a Renovate bump to the pin
# takes effect on the next apply. Logs under the package's unscoped name
# (@readwise/cli -> readwise-cli).
pin_npm_global() {
  local package="$1" version="$2" label installed
  label="${package#@}"
  label="${label//\//-}"
  installed="$(installed_npm_version "$package")"

  if [ "$installed" = "$version" ]; then
    log "$label: $version already installed"
    return
  fi
  if [ -n "$installed" ]; then
    log "$label: replacing $installed with $version"
  else
    log "$label: installing $version"
  fi
  npm install -g "$package@$version"
}

# ---------------------------------------------------------------- Claude Code
if ! command -v claude >/dev/null 2>&1; then
  log "claude-code: npm install -g @anthropic-ai/claude-code"
  npm install -g @anthropic-ai/claude-code
else
  log "claude-code: already installed"
fi

# ----------------------------------------------------------- Readwise CLI
# renovate: datasource=npm depName=@readwise/cli
READWISE_CLI_VERSION="0.5.9"
pin_npm_global "@readwise/cli" "$READWISE_CLI_VERSION"

# --------------------------------------------------------- devcontainers CLI
# Backs the global guide's devcontainer-exec helper.
# renovate: datasource=npm depName=@devcontainers/cli
DEVCONTAINER_CLI_VERSION="0.88.0"
pin_npm_global "@devcontainers/cli" "$DEVCONTAINER_CLI_VERSION"

# ---------------------------------------------------------------------- pnpm
# Backs dev-cache-gc's `pnpm store prune`.
# renovate: datasource=npm depName=pnpm
PNPM_VERSION="11.22.0"
pin_npm_global "pnpm" "$PNPM_VERSION"

# -------------------------------------------------------------------- bobbit
# Browser-driven multi-agent orchestrator; runs its own gateway server and
# gives each role agent its own git worktree. Needs node >= 22.19, which the
# pin above clears.
# renovate: datasource=npm depName=bobbit
BOBBIT_VERSION="0.15.1"
pin_npm_global "bobbit" "$BOBBIT_VERSION"

log "node ecosystem complete"
