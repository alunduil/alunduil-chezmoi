#!/usr/bin/env bash
# chezmoi deploys only under $HOME, so daemon.json and the docker-prune units
# live in etc/ and install with sudo. ADR 0006 explains why the prune is a root
# system unit.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

if ! command -v docker >/dev/null 2>&1; then
  log "docker: absent; skipping"
  exit 0
fi

ETC_SRC="{{ .chezmoi.sourceDir }}/etc"

# ------------------------------------------------------------------- daemon
# The `local` log driver rotates each container's log. json-file, the default,
# grows until the prune removes the container.
#
# dockerd reads daemon.json only at start. try-restart applies it to a running
# daemon without starting a stopped one.
DAEMON_JSON_SRC="$ETC_SRC/docker/daemon.json"
DAEMON_JSON=/etc/docker/daemon.json

if ! cmp -s "$DAEMON_JSON_SRC" "$DAEMON_JSON"; then
  install_if_changed -D -m 0644 "$DAEMON_JSON_SRC" "$DAEMON_JSON"
  # Declining the replace leaves the running daemon's config as it is.
  if cmp -s "$DAEMON_JSON_SRC" "$DAEMON_JSON"; then
    log "restarting docker.service; running containers restart with it"
    sudo systemctl try-restart docker.service
  fi
fi

# -------------------------------------------------------------------- prune
for unit in docker-prune.service docker-prune.timer; do
  install_if_changed -m 0644 "$ETC_SRC/systemd/system/$unit" "/etc/systemd/system/$unit"
done

daemon_reload_if_installed

enable_now docker-prune.timer
