#!/usr/bin/env bash
# Configures the Docker daemon and installs the docker-prune system units.
# Docker is a rootful system daemon here, so the prune runs as root on a system
# timer rather than the per-user pattern of dev-cache-gc -- chezmoi targets
# $HOME, not /etc, so daemon.json and the units live in etc/ and are copied in
# with sudo (same shape as the unattended-upgrades config). See #312.
#
# The `local` log driver rotates each container's log, which json-file, the
# default, leaves uncapped until the prune removes the container. Running
# containers keep the driver they started with.
#
# Each file is compared against its deployed copy, so an edit here and a
# hand-edit under /etc both reconcile.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

# Docker is the whole point; a host without it has nothing to configure.
if ! command -v docker >/dev/null 2>&1; then
  log "docker: absent; skipping"
  exit 0
fi

ETC_SRC="{{ .chezmoi.sourceDir }}/etc"

# ------------------------------------------------------------------- daemon
# dockerd reads daemon.json only at start. try-restart leaves a stopped daemon
# stopped; it picks the file up when it next starts.
if ! cmp -s "$ETC_SRC/docker/daemon.json" /etc/docker/daemon.json; then
  log "installing /etc/docker/daemon.json"
  sudo install -D -m 0644 "$ETC_SRC/docker/daemon.json" /etc/docker/daemon.json
  sudo systemctl try-restart docker.service
fi

# -------------------------------------------------------------------- prune
for unit in docker-prune.service docker-prune.timer; do
  install_if_changed -m 0644 "$ETC_SRC/systemd/system/$unit" "/etc/systemd/system/$unit"
done

daemon_reload_if_installed

enable_now docker-prune.timer
