#!/usr/bin/env bash
# See docs/adr/0009-install-pinned-tools-through-mise.md. `mise install`
# skips every locked version already on disk, so a bump and a deleted tool
# reconcile the same way.
#
# A fresh host has no ~/.config/mise before apply, so mise reads the config
# from the source tree, beside the lockfile's npm sidecars.
#
# chezmoi runs passes from $HOME, where mise would otherwise read the last
# apply's ~/.config/mise/config.toml as project config, report its pins
# installed, and skip a bump. The host restriction switches that off whether
# or not the calling shell has sourced it.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

set -a
# shellcheck source=dot_config/environment.d/mise.conf
. "{{ .chezmoi.sourceDir }}/dot_config/environment.d/mise.conf"
set +a

MISE_GLOBAL_CONFIG_FILE="{{ .chezmoi.sourceDir }}/dot_config/mise/config.toml" mise install
