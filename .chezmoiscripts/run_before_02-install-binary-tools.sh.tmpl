#!/usr/bin/env bash
# Third-party binaries that chezmoi externals cannot deliver. Release binaries
# pinned by URL are externals (.chezmoiexternal.toml.tmpl); what stays here
# needs more than a download. Each script/install/* pins its own version and
# no-ops when that version is already on disk, so a version bump and a deleted
# binary reconcile by the same path.

set -euo pipefail

INSTALL_DIR="{{ .chezmoi.sourceDir }}/script/install"

# GPG-signed with no published checksum; externals verify hashes, not
# signatures.
"$INSTALL_DIR/signal-cli" --bin-dir "$HOME/.local/bin"

mkdir -p "$HOME/.config/zellij/plugins"
