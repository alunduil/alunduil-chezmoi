#!/usr/bin/env bash
# See docs/adr/0009-install-pinned-tools-through-mise.md. `mise install`
# skips every locked version already on disk, so a bump and a deleted tool
# reconcile the same way.
#
# A fresh host has no ~/.config/mise before apply, so mise reads the config
# from the source tree, beside the lockfile's npm sidecars.

set -euo pipefail

MISE_GLOBAL_CONFIG_FILE="{{ .chezmoi.sourceDir }}/dot_config/mise/config.toml" mise install

# signal-cli publishes GPG signatures, which mise can't check against a pinned
# key.
"{{ .chezmoi.sourceDir }}/script/install/signal-cli" --bin-dir "$HOME/.local/bin"
