#!/usr/bin/env bash
# LoadCredential= copies the Grafana Cloud token only at service start, so
# Alloy needs a restart to send a rotated one.
# token-hash: {{ includeTemplate "onepassword-read" .onepassword.grafana_cloud | sha256sum }}

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

# The restart fails without a user manager, leaving the token hash unrecorded
# so the next apply retries it.
systemctl --user show-environment >/dev/null 2>&1 ||
  log "alloy: no user systemd session; the restart below fails"

systemctl --user try-restart alloy.service
