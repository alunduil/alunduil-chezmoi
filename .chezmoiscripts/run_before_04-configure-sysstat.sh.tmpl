#!/usr/bin/env bash
# sysstat is the local, in-incident recorder. sadc runs as root in
# system.slice, so it keeps sampling to /var/log/sysstat through a
# user-1000.slice pids exhaustion -- the failure that stops every collector
# sharing the user slice, including the Alloy shipper. See #404.
#
# ENABLED in /etc/default/sysstat gates the systemd units: the package's
# postinst reads it and enables or disables sysstat.service and its timers.
# The package's config script copies ENABLED from that file into debconf,
# overwriting any preseed, so the file is where to set it. dpkg-reconfigure
# records the edit with ucf, so upgrades keep it.
#
# The guard reads the deployed file rather than asking debconf, because
# debconf-show needs root and a converged host must not reach sudo.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

ETC_SRC="{{ .chezmoi.sourceDir }}/etc"

# ------------------------------------------------------------------- config
install_if_changed -m 0644 "$ETC_SRC/sysstat/sysstat" /etc/sysstat/sysstat
install_if_changed -D -m 0644 \
  "$ETC_SRC/systemd/system/sysstat-collect.timer.d/interval.conf" \
  /etc/systemd/system/sysstat-collect.timer.d/interval.conf

daemon_reload_if_installed

# ----------------------------------------------------------------- collection
if ! grep -qx 'ENABLED="true"' /etc/default/sysstat 2>/dev/null; then
  log "enabling sysstat collection"
  sudo sed -i 's/^ENABLED=.*/ENABLED="true"/' /etc/default/sysstat
  sudo dpkg-reconfigure -f noninteractive sysstat
fi

enable_now sysstat.service sysstat-collect.timer

log "sysstat configured"
