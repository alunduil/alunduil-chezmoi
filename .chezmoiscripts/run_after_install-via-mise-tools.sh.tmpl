#!/usr/bin/env bash
# uv and gcx shims resolve through ~/.config/mise, which apply deploys.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"
use_mise_shims
use_local_bin

# Music-library tagger. pyacoustid and musicbrainzngs have no entry point of
# their own, so they ride in beets' tool environment via --with rather than
# being installed as tools; beets 2.x dropped musicbrainzngs as a dependency
# and ships its own MusicBrainz client, so the pin here is deliberate and not
# a restatement of beets' metadata. Its fingerprinter needs fpcalc
# (libchromaprint-tools, script 01). The guard compares the whole requirement
# set, not just beets' version, so bumping either --with pin reinstalls. uv's
# listing reads only package metadata, so the guard also runs `beet version`:
# an environment that lost module files still lists as installed, and
# --reinstall replaces packages uv would otherwise count as present.
# renovate: datasource=pypi depName=beets
BEETS_VERSION="2.14.1"
# renovate: datasource=pypi depName=pyacoustid
PYACOUSTID_VERSION="1.3.1"
# renovate: datasource=pypi depName=musicbrainzngs
MUSICBRAINZNGS_VERSION="0.7.1"
beets_installed="beets v$BEETS_VERSION [required: ==$BEETS_VERSION] [with: pyacoustid==$PYACOUSTID_VERSION, musicbrainzngs==$MUSICBRAINZNGS_VERSION]"
if uv tool list --show-with --show-version-specifiers 2>/dev/null |
  grep -qxF "$beets_installed" && beet version >/dev/null 2>&1; then
  log "beets: $BEETS_VERSION already installed via uv"
else
  log "beets: installing $BEETS_VERSION via uv"
  uv tool install --force --reinstall \
    --with "pyacoustid==$PYACOUSTID_VERSION" \
    --with "musicbrainzngs==$MUSICBRAINZNGS_VERSION" \
    "beets==$BEETS_VERSION"
fi

# gcx ships its skill bundle inside the binary; `agent skills install --all`
# extracts it to ~/.agents/skills (the cross-harness convention read by Claude
# Code, Cursor, Copilot). --force re-syncs gcx-managed files on version bumps
# without touching anything outside the bundle.
gcx agent skills install --all --force >/dev/null
