#!/usr/bin/env bash
# uv and gcx shims resolve through ~/.config/mise, which apply deploys.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"
use_mise_shims
use_local_bin

# Music-library tagger. pyacoustid (chroma plugin) and pylast (lastgenre
# plugin) have no entry point of their own, so they ride in beets' tool
# environment via --with rather than being installed as tools. The plugin set
# lives in dot_config/beets/config.yaml.tmpl. The fingerprinter needs fpcalc
# (libchromaprint-tools, script 01).
# renovate: datasource=pypi depName=beets
BEETS_VERSION="2.14.1"
# renovate: datasource=pypi depName=pyacoustid
PYACOUSTID_VERSION="1.3.1"
# renovate: datasource=pypi depName=pylast
PYLAST_VERSION="7.2.0"

# Bumping any of the three pins reinstalls. uv lists tools from package
# metadata alone, so a tool whose module files are gone still lists. Its
# packages still count as present, so the install needs --reinstall. beets
# opens and migrates its library on startup, so the probe runs against a
# scratch BEETSDIR and writes no bytecode into the environment.
beets_installed() {
  local expected="beets v$BEETS_VERSION [required: ==$BEETS_VERSION] [with: pyacoustid==$PYACOUSTID_VERSION, pylast==$PYLAST_VERSION]"
  uv tool list --show-with --show-version-specifiers 2>/dev/null |
    grep -qxF "$expected" || return 1

  local beetsdir status=0
  beetsdir="$(mktemp -d)"
  BEETSDIR="$beetsdir" PYTHONDONTWRITEBYTECODE=1 beet version >/dev/null 2>&1 ||
    status=$?
  rm -rf "$beetsdir"
  return "$status"
}

if beets_installed; then
  log "beets: $BEETS_VERSION already installed via uv"
else
  log "beets: installing $BEETS_VERSION via uv"
  uv tool install --force --reinstall \
    --with "pyacoustid==$PYACOUSTID_VERSION" \
    --with "pylast==$PYLAST_VERSION" \
    "beets==$BEETS_VERSION"
fi

# gcx ships its skill bundle inside the binary; `agent skills install --all`
# extracts it to ~/.agents/skills (the cross-harness convention read by Claude
# Code, Cursor, Copilot). --force re-syncs gcx-managed files on version bumps
# without touching anything outside the bundle.
gcx agent skills install --all --force >/dev/null
