#!/usr/bin/env bash
# uv and gcx shims resolve through ~/.config/mise, which apply deploys.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"
use_mise_shims
use_local_bin

# Whether uv lists <name> at <version> with exactly these --with extras.
# uv lists tools from package metadata alone, so a tool whose module files
# are gone still lists: callers also run the tool, and install with
# --reinstall because its packages still count as present.
uv_tool_at_pin() {
  local name=$1 version=$2
  shift 2
  local expected="$name v$version [required: ==$version]"
  if (($#)); then
    local with
    printf -v with '%s, ' "$@"
    expected+=" [with: ${with%, }]"
  fi
  uv tool list --show-with --show-version-specifiers 2>/dev/null |
    grep -qxF "$expected"
}

# Music-library tagger. pyacoustid (chroma) and pylast (lastgenre) are
# libraries for the plugins enabled in dot_config/beets/config.yaml.tmpl, so
# they install into beets' tool environment. chroma needs fpcalc
# (libchromaprint-tools, script 01).
# renovate: datasource=pypi depName=beets
BEETS_VERSION="2.14.1"
# renovate: datasource=pypi depName=pyacoustid
PYACOUSTID_VERSION="1.3.1"
# renovate: datasource=pypi depName=pylast
PYLAST_VERSION="7.2.0"
BEETS_WITH=("pyacoustid==$PYACOUSTID_VERSION" "pylast==$PYLAST_VERSION")

# Bumping any of the three pins reinstalls. beets opens and migrates its
# library on startup, so the probe runs against a scratch BEETSDIR and writes
# no bytecode into the environment.
beets_installed() {
  uv_tool_at_pin beets "$BEETS_VERSION" "${BEETS_WITH[@]}" || return 1

  local beetsdir status=0
  beetsdir="$(mktemp -d)"
  BEETSDIR="$beetsdir" PYTHONDONTWRITEBYTECODE=1 beet version >/dev/null 2>&1 ||
    status=$?
  rm -rf "$beetsdir"
  return "$status"
}

if beets_installed; then
  log "beets: $BEETS_VERSION already installed via uv"
else
  log "beets: installing $BEETS_VERSION via uv"
  uv tool install --force --reinstall \
    "${BEETS_WITH[@]/#/--with=}" \
    "beets==$BEETS_VERSION"
fi

# Adds a text layer to scanned PDFs. Shells out to tesseract, ghostscript,
# unpaper, and pngquant from apt.
# renovate: datasource=pypi depName=ocrmypdf
OCRMYPDF_VERSION="17.14.2"

if uv_tool_at_pin ocrmypdf "$OCRMYPDF_VERSION" &&
  ocrmypdf --version >/dev/null 2>&1; then
  log "ocrmypdf: $OCRMYPDF_VERSION already installed via uv"
else
  log "ocrmypdf: installing $OCRMYPDF_VERSION via uv"
  uv tool install --force --reinstall "ocrmypdf==$OCRMYPDF_VERSION"
fi

# gcx ships its skill bundle inside the binary; `agent skills install --all`
# extracts it to ~/.agents/skills (the cross-harness convention read by Claude
# Code, Cursor, Copilot). --force re-syncs gcx-managed files on version bumps
# without touching anything outside the bundle.
gcx agent skills install --all --force >/dev/null
