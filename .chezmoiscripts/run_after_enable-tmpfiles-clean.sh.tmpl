#!/usr/bin/env bash
# The config hashes below re-run this script when a cleaner config appears or
# changes, re-asserting the (system-provided) timers.
# cache cleaner config:     {{ include "dot_config/user-tmpfiles.d/cache.conf" | sha256sum }}
# downloads cleaner config: {{ include "dot_config/user-tmpfiles.d/downloads.conf" | sha256sum }}
# trash cleaner config:     {{ include "dot_config/user-tmpfiles.d/trash.conf" | sha256sum }}
# tmp cleaner config:       {{ include "etc/tmpfiles.d/tmp.conf" | sha256sum }}
#
# The system timer is static and already runs daily, so the system side needs
# only the tmp.conf override.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

ETC_SRC="{{ .chezmoi.sourceDir }}/etc"

install_if_changed -m 0644 "$ETC_SRC/tmpfiles.d/tmp.conf" /etc/tmpfiles.d/tmp.conf

enable_user_units tmpfiles-clean systemd-tmpfiles-clean.timer
