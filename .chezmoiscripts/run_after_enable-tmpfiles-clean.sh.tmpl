#!/usr/bin/env bash
# The config hash below re-runs this script when the cleaner config appears or
# changes, re-asserting the (system-provided) timer.
# cache cleaner config: {{ include "dot_config/user-tmpfiles.d/cache.conf" | sha256sum }}

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

enable_user_units tmpfiles-clean systemd-tmpfiles-clean.timer
