#!/usr/bin/env bash
# Unit hashes below re-run this script whenever a unit changes, so edits
# (new ExecStart flags, added units) re-apply via daemon-reload + enable.
# alloy unit:     {{ include "dot_config/systemd/user/alloy.service" | sha256sum }}
# textfile unit:  {{ include "dot_config/systemd/user/cgroup-pids-textfile.service" | sha256sum }}
# textfile timer: {{ include "dot_config/systemd/user/cgroup-pids-textfile.timer" | sha256sum }}

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

units=(cgroup-pids-textfile.timer)

# alloy.service fails to start without its token, which the first bootstrap
# pass does not deploy.
if [ -s "$HOME/.config/grafana-cloud/token" ]; then
  units+=(alloy.service)
else
  log "telemetry: no Grafana Cloud token yet; leaving alloy disabled"
fi

enable_user_units telemetry "${units[@]}"
