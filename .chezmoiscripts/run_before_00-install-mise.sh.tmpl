#!/usr/bin/env bash
# Installs the mise pinned in dot_config/mise/config.toml, with whichever mise
# is on PATH: the tutorial's seed on a fresh host, or the last apply's pin.
# mise.lock's checksum fails a tampered download here, before it runs. Later
# passes reach the pin through use_pinned_mise.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"
restrict_mise_to_global_config
export MISE_GLOBAL_CONFIG_FILE="{{ .chezmoi.sourceDir }}/dot_config/mise/config.toml"

mise install github:jdx/mise
pin="$(mise where github:jdx/mise)/bin/mise"

# mise links each shim to the first mise on PATH rather than to the binary
# running, and prune relinks them too. prune keeps any version a process is
# running from, so the old mise has to have exited.
PATH="${pin%/*}:$PATH"
mise reshim
mise prune --tools --yes github:jdx/mise
