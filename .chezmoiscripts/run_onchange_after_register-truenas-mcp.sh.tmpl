#!/usr/bin/env bash
# Registers TrueNAS Research Labs' official MCP with Claude Code, which
# bakes the -e values, API key included, into ~/.claude.json.
#
# Why run_onchange_after instead of a converging run_before pass:
#   - _after_: ~/.config/truenas/ exists only once files are applied.
#   - run_onchange, keyed on the hashes below: a change to any input reruns
#     this script and replaces the stale entry in ~/.claude.json.
# key-hash: {{ includeTemplate "onepassword-read" .onepassword.truenas | sha256sum }}
# user-hash: {{ includeTemplate "onepassword-read" .onepassword.truenas_user | sha256sum }}
# url-hash: {{ include "dot_config/truenas/url" | sha256sum }}

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"
use_mise_shims
use_local_bin

read_setting() {
  local label="$1" file="$HOME/.config/truenas/$2"
  if [ ! -s "$file" ]; then
    log "truenas-mcp: $label missing or empty at $file, skipping"
    return 1
  fi
  cat -- "$file"
}

url="$(read_setting url url)" || exit 0 # rerun-on: url-hash
key="$(read_setting "api key" api_key)" || exit 0 # rerun-on: key-hash
user="$(read_setting "api key user" user)" || exit 0 # rerun-on: user-hash

# Resolves to the shim, whose path stays the same across version bumps, so
# ~/.claude.json does too.
bin="$(command -v truenas-mcp || true)"
if [ -z "$bin" ]; then
  log "truenas-mcp: not on PATH, registration retries on the next apply"
  exit 1
fi

# --insecure: the cert carries no IP SANs and the URL is an address, so
# verification can never match the name. --tls-ca does not help a mismatch.
reregister_mcp truenas \
  -e "TRUENAS_URL=${url}" \
  -e "TRUENAS_API_KEY=${key}" \
  -e "TRUENAS_API_USER=${user}" \
  -- "$bin" --insecure
