#!/usr/bin/env bash
# Registers TrueNAS Research Labs' official MCP with Claude Code. Local
# stdio binary (truenas-mcp, a chezmoi external) plus URL and API key
# passed as -e env vars, which Claude Code bakes into ~/.claude.json.
#
# Why run_onchange_after instead of a converging run_before pass:
#   - _after_: ~/.config/truenas/api_key and url exist only once files are
#     applied.
#   - run_onchange, keyed on the key's value and the URL: a rotation or a new
#     URL reruns this script and replaces the stale entry in ~/.claude.json.
# key-hash: {{ includeTemplate "onepassword-read" .onepassword.truenas | sha256sum }}
# url-hash: {{ include "dot_config/truenas/url" | sha256sum }}

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"

url_file="$HOME/.config/truenas/url"
key_file="$HOME/.config/truenas/api_key"
bin="$HOME/.local/bin/truenas-mcp"

if [ ! -s "$url_file" ]; then
  log "truenas-mcp: url missing or empty at $url_file, skipping"
  exit 0
fi
if [ ! -r "$key_file" ]; then
  log "truenas-mcp: api key not deployed at $key_file, skipping"
  exit 0
fi
if [ ! -x "$bin" ]; then
  log "truenas-mcp: binary missing at $bin, skipping"
  exit 0
fi

url="$(<"$url_file")"
key="$(<"$key_file")"

# Idempotent re-register: remove any existing entry (no-op if absent) and
# add afresh so a rotated key or changed URL replaces the stale entry in
# ~/.claude.json.
claude mcp remove truenas --scope user >/dev/null 2>&1 || true
log "truenas-mcp: registering"
# --insecure: the cert carries no IP SANs and the URL is an address, so
# verification can never match the name. --tls-ca does not help a mismatch.
claude mcp add truenas --scope user \
  -e "TRUENAS_URL=${url}" \
  -e "TRUENAS_API_KEY=${key}" \
  -- "$bin" --insecure
