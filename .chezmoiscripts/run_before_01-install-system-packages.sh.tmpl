#!/usr/bin/env bash
# Installs system-level packages via apt and adds third-party apt repos as
# needed. Must run before other bootstrap scripts so that system tools (curl,
# jq, gpg, etc.) are available.

set -euo pipefail

log() { printf '==> %s\n' "$*" >&2; }

# `dpkg -s` is not this test: it exits 0 for a package in config-files state --
# removed with `apt remove` but its conffiles retained -- so a package gone
# from disk reads as present and never gets reinstalled.
is_installed() {
  [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true)" = "installed" ]
}

# Registers a signed third-party apt repository unless its keyring already
# exists, so a converged host makes no sudo call. The keyring path is the
# guard, so renaming an existing keyring or list re-registers on every host.
#
#   add_apt_repo KEYRING KEY_URL LIST ENTRY [OPTIONS]
#
# KEYRING and LIST are file names under /usr/share/keyrings/ and
# /etc/apt/sources.list.d/. ENTRY is the URI, suite, and components; OPTIONS
# are deb options besides signed-by.
add_apt_repo() {
  local keyring="/usr/share/keyrings/$1" key_url="$2" list="$3" entry="$4" options="${5:-}"
  [ -f "$keyring" ] && return
  log "${list%.list}: adding apt repository"
  curl -fsSL "$key_url" | sudo gpg --dearmor -o "$keyring"
  printf 'deb [%ssigned-by=%s] %s\n' "${options:+$options }" "$keyring" "$entry" |
    sudo tee "/etc/apt/sources.list.d/$list" >/dev/null
}

arch=$(dpkg --print-architecture)
codename='{{ .chezmoi.osRelease.versionCodename }}'

add_apt_repo hashicorp-archive-keyring.gpg https://apt.releases.hashicorp.com/gpg \
  hashicorp.list "https://apt.releases.hashicorp.com $codename main"

add_apt_repo githubcli-archive-keyring.gpg https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  github-cli.list 'https://cli.github.com/packages stable main' "arch=$arch"

# Signal publishes amd64 builds only, under the fixed suite xenial.
add_apt_repo signal-desktop-keyring.gpg https://updates.signal.org/desktop/apt/keys.asc \
  signal-xenial.list 'https://updates.signal.org/desktop/apt xenial main' 'arch=amd64'

add_apt_repo docker-archive-keyring.gpg https://download.docker.com/linux/debian/gpg \
  docker.list "https://download.docker.com/linux/debian $codename stable" "arch=$arch"

# temurin-21-jdk backs the JVM-based Firebase emulators that genshin's
# `pnpm dev` starts when that project is developed on the host rather than in
# its devcontainer. Debian bookworm ships no openjdk-21 in main, security, or
# backports, so Adoptium is where a 21 comes from; it is also what the
# devcontainers `java:1` feature installs, keeping both paths on one runtime.
add_apt_repo adoptium-archive-keyring.gpg https://packages.adoptium.net/artifactory/api/gpg/key/public \
  adoptium.list "https://packages.adoptium.net/artifactory/deb $codename main"

# -------------------------------------------------------------------- keybase
# Outside add_apt_repo: there is no key. Keybase's apt repo is unsigned; their
# official install guide uses `[trusted=yes]` to skip apt's signature check.
# Transport integrity comes from HTTPS to prerelease.keybase.io. The keybase
# service self-updates once installed, so versions track upstream regardless.
if [ ! -f /etc/apt/sources.list.d/keybase.list ]; then
  log "keybase: adding apt repository"
  printf 'deb [trusted=yes] https://prerelease.keybase.io/deb stable main\n' |
    sudo tee /etc/apt/sources.list.d/keybase.list >/dev/null
fi

# --------------------------------------------------------------- vscode (code)
# We install `code` from its upstream .deb (below), whose postinst manages the
# apt repo itself (vscode.sources + microsoft.gpg). A hand-rolled vscode.list
# naming a second keyring path collides with that postinst source and wedges
# apt with a "Conflicting values set for option Signed-By" error. Drop the
# stale entry before any apt call so sources stay readable.
if [ -e /etc/apt/sources.list.d/vscode.list ] ||
  [ -e /usr/share/keyrings/packages.microsoft.gpg ]; then
  log "vscode: dropping stale hand-rolled apt source"
  sudo rm -f /etc/apt/sources.list.d/vscode.list /usr/share/keyrings/packages.microsoft.gpg
fi

# ------------------------------------------------------------------ 1password
# Outside add_apt_repo: the debsig steps share its keyring guard. CLI only
# (1password-cli), not the desktop app. The debsig policy is how apt
# verifies the package signature at install; 1Password publishes it separately
# from the apt signing key, keyed by their fixed origin id AC2D62742012EA22.
if [ ! -f /usr/share/keyrings/1password-archive-keyring.gpg ]; then
  log "1password: adding apt repository"
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --dearmor -o /usr/share/keyrings/1password-archive-keyring.gpg
  printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' \
    "$arch" "$arch" |
    sudo tee /etc/apt/sources.list.d/1password.list >/dev/null
  sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22/
  curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol |
    sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol >/dev/null
  sudo mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22
  curl -fsSL https://downloads.1password.com/linux/keys/1password.asc |
    sudo gpg --dearmor -o /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
fi

# -------------------------------------------------------------------- apt pkgs
read -ra APT_PACKAGES <<<'{{ join " " .packages.apt }}'

missing=()
for pkg in "${APT_PACKAGES[@]}"; do
  is_installed "$pkg" || missing+=("$pkg")
done
if ((${#missing[@]} > 0)); then
  log "apt: installing ${missing[*]}"
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
else
  log "apt: all packages present"
fi

# --------------------------------------------------------------- vscode (code)
# Installed from the upstream .deb rather than the apt batch so its postinst
# owns the apt repo (see the keyring cleanup above). Pulls dependencies from
# the now-readable apt sources.
if ! command -v code >/dev/null 2>&1; then
  log "vscode: installing from upstream .deb"
  curl -fsSL 'https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64' -o /tmp/code.deb
  sudo apt-get install -y /tmp/code.deb
  rm -f /tmp/code.deb
fi

# ---------------------------------------------------------------- tailscale
# System daemon. The official installer is idempotent and handles apt
# signing key + repo + package in one go. `tailscale up` (interactive
# browser auth) is a separate per-machine manual step -- see README.
if ! command -v tailscale >/dev/null 2>&1; then
  log "tailscale: running official installer"
  curl -fsSL https://tailscale.com/install.sh | sh
else
  log "tailscale: already installed"
fi
if ! systemctl is-enabled --quiet tailscaled 2>/dev/null ||
  ! systemctl is-active --quiet tailscaled 2>/dev/null; then
  log "tailscale: enabling tailscaled"
  sudo systemctl enable --now tailscaled
fi

log "system packages complete"
