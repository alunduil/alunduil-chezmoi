#!/usr/bin/env bash
# See docs/adr/0009-install-pinned-tools-through-mise.md. `mise install`
# skips every locked version already on disk, so a bump and a deleted tool
# reconcile the same way.

set -euo pipefail

# shellcheck source=script/lib/bootstrap.sh
. "{{ .chezmoi.sourceDir }}/script/lib/bootstrap.sh"
use_pinned_mise
use_source_mise_config

mise install
