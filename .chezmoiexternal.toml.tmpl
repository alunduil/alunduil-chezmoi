{{/*
  Release binaries, versioned in .chezmoidata/versions.yaml. A GitHub release
  asset is immutable, so the pinned URL fixes the bytes and no checksum is
  stored; docs/adr/0008-install-release-binaries-as-chezmoi-externals.md
  carries why. Source-archive tarballs are the exception: GitHub generates
  them on request, so their hash is pinned and refreshed by hand on a bump.
*/ -}}
{{- $v := .versions -}}
{{- $gh := "https://github.com" -}}

[".local/bin/act"]
    type = "archive-file"
    url = "{{ $gh }}/nektos/act/releases/download/{{ $v.ACT_VERSION }}/act_Linux_x86_64.tar.gz"
    path = "act"
    executable = true

[".local/bin/alloy"]
    type = "archive-file"
    url = "{{ $gh }}/grafana/alloy/releases/download/{{ $v.ALLOY_VERSION }}/alloy-linux-amd64.zip"
    path = "alloy-linux-amd64"
    executable = true

[".local/bin/gcx"]
    type = "archive-file"
    url = "{{ $gh }}/grafana/gcx/releases/download/{{ $v.GCX_VERSION }}/gcx_{{ trimPrefix "v" $v.GCX_VERSION }}_linux_amd64.tar.gz"
    path = "gcx"
    executable = true

[".local/bin/just"]
    type = "archive-file"
    url = "{{ $gh }}/casey/just/releases/download/{{ $v.JUST_VERSION }}/just-{{ $v.JUST_VERSION }}-x86_64-unknown-linux-musl.tar.gz"
    path = "just"
    executable = true

[".local/bin/lazygit"]
    type = "archive-file"
    url = "{{ $gh }}/jesseduffield/lazygit/releases/download/{{ $v.LAZYGIT_VERSION }}/lazygit_{{ trimPrefix "v" $v.LAZYGIT_VERSION }}_linux_x86_64.tar.gz"
    path = "lazygit"
    executable = true

[".local/bin/lychee"]
    type = "archive-file"
    url = "{{ $gh }}/lycheeverse/lychee/releases/download/lychee-{{ $v.LYCHEE_VERSION }}/lychee-x86_64-unknown-linux-musl.tar.gz"
    path = "lychee-x86_64-unknown-linux-musl/lychee"
    executable = true

[".local/bin/trivy"]
    type = "archive-file"
    url = "{{ $gh }}/aquasecurity/trivy/releases/download/{{ $v.TRIVY_VERSION }}/trivy_{{ trimPrefix "v" $v.TRIVY_VERSION }}_Linux-64bit.tar.gz"
    path = "trivy"
    executable = true

[".local/bin/truenas-mcp"]
    type = "archive-file"
    url = "{{ $gh }}/truenas/truenas-mcp/releases/download/{{ $v.TRUENAS_MCP_VERSION }}/truenas-mcp-linux-amd64.tar.gz"
    path = "truenas-mcp-linux-amd64"
    executable = true

[".local/bin/uv"]
    type = "archive-file"
    url = "{{ $gh }}/astral-sh/uv/releases/download/{{ $v.UV_VERSION }}/uv-x86_64-unknown-linux-musl.tar.gz"
    path = "uv-x86_64-unknown-linux-musl/uv"
    executable = true

[".local/bin/vale"]
    type = "archive-file"
    url = "{{ $gh }}/vale-cli/vale/releases/download/{{ $v.VALE_VERSION }}/vale_{{ trimPrefix "v" $v.VALE_VERSION }}_Linux_64-bit.tar.gz"
    path = "vale"
    executable = true

[".local/bin/yq"]
    type = "file"
    url = "{{ $gh }}/mikefarah/yq/releases/download/{{ $v.YQ_VERSION }}/yq_linux_amd64"
    executable = true

[".local/bin/zellij"]
    type = "archive-file"
    url = "{{ $gh }}/zellij-org/zellij/releases/download/{{ $v.ZELLIJ_VERSION }}/zellij-x86_64-unknown-linux-musl.tar.gz"
    path = "zellij"
    executable = true

# bats-support and bats-assert: the assertion helpers the *.bats suites load
# through bats_load_library.
[".local/lib/bats/bats-support"]
    type = "archive"
    url = "{{ $gh }}/bats-core/bats-support/archive/refs/tags/{{ $v.BATS_SUPPORT_VERSION }}.tar.gz"
    stripComponents = 1
    exact = true
    checksum.sha256 = "7815237aafeb42ddcc1b8c698fc5808026d33317d8701d5ec2396e9634e2918f"

[".local/lib/bats/bats-assert"]
    type = "archive"
    url = "{{ $gh }}/bats-core/bats-assert/archive/refs/tags/{{ $v.BATS_ASSERT_VERSION }}.tar.gz"
    stripComponents = 1
    exact = true
    checksum.sha256 = "e305df20c4c36cba4570e10f1cd824efb1ae71d88b5ef474550781ebee04192f"
