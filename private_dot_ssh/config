# This file is public; private hosts go in config.d/.
Include ~/.ssh/config.d/*

Host homeassistant
	HostName 192.168.68.56
	HostKeyAlias homeassistant
	User hassio
	Port 22
	ControlMaster auto
	ControlPath ~/.ssh/sockets/%r@%h:%p
	ControlPersist 10m

# SFTP login for homeassistant-config.service. Same box, reached by tailnet
# name, so the pinned homeassistant key applies.
Host homeassistant-sftp
	HostName homeassistant.tail3af06.ts.net
	HostKeyAlias homeassistant
	User hassio

# Reloads an expired key before each connection. The block sets nothing; only
# the side effect matters.
Match exec "~/.local/bin/ssh-load"

# On Crostini, tailscaled runs without a TUN device, so tailnet names neither
# resolve nor route from the shell. Match host tests the HostName, so aliases
# pointing at the tailnet take the proxy too.
# https://github.com/tailscale/tailscale/issues/12090
Match host *.ts.net
	ProxyCommand tailscale nc %h %p

Host *
	IdentityAgent ${XDG_RUNTIME_DIR}/ssh-agent.socket
	# Keep known_hosts first: ssh writes accepted keys to the first file, which
	# leaves the pins as chezmoi wrote them.
	UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.d/pinned
